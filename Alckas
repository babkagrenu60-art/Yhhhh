local function closePanel()
	open=false
	TS:Create(F,TweenInfo.new(.3,Enum.EasingStyle.Quint,Enum.EasingDirection.In),{
		Size=UDim2.fromOffset(0,0),
		Position=UDim2.new(.5,0,.5,0)
	}):Play()
end

local function openPanel()
	open=true
	F.Size=UDim2.fromOffset(0,0)
	F.Position=UDim2.new(.5,0,.5,0)
	TS:Create(F,TweenInfo.new(.35,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{
		Size=UDim2.fromOffset(310,370),
		Position=UDim2.new(.5,-155,.5,-185)
	}):Play()
end

T.InputBegan:Connect(function(i)
	if i.UserInputType==Enum.UserInputType.Touch then
		local start=i.Position
		local pos=F.Position
		local moving=true

		local con
		con=UIS.InputChanged:Connect(function(x)
			if moving and x.UserInputType==Enum.UserInputType.Touch then
				local d=x.Position-start
				F.Position=UDim2.new(pos.X.Scale,pos.X.Offset+d.X,pos.Y.Scale,pos.Y.Offset+d.Y)
			end
		end)

		i.Changed:Connect(function()
			if i.UserInputState==Enum.UserInputState.End then
				moving=false
				con:Disconnect()
			end
		end)
	end
end)

openBtn.MouseButton1Click:Connect(function()
	if open then
		closePanel()
	else
		openPanel()
	end
end)
