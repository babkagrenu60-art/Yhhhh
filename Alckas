local function hum()
	local c=plr.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function root()
	local c=plr.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function clear()
	for _,v in ipairs(C:GetChildren())do
		if v:IsA("GuiObject")then v:Destroy()end
	end
end

local function toggle(name,get,set)
	local box=Instance.new("Frame",C)
	box.Size=UDim2.new(1,-5,0,46)
	box.BackgroundColor3=Color3.fromRGB(27,27,37)
	Instance.new("UICorner",box).CornerRadius=UDim.new(0,11)

	local text=Instance.new("TextLabel",box)
	text.Size=UDim2.new(1,-70,1,0);text.Position=UDim2.fromOffset(12,0)
	text.Text=name;text.TextColor3=Color3.new(1,1,1)
	text.TextSize=14;text.Font=Enum.Font.GothamBold;text.BackgroundTransparency=1
	text.TextXAlignment=Enum.TextXAlignment.Left

	local b=Instance.new("TextButton",box)
	b.Size=UDim2.fromOffset(48,25);b.Position=UDim2.new(1,-58,.5,-12)
	b.Text="OFF";b.TextSize=11;b.Font=Enum.Font.GothamBold
	b.TextColor3=Color3.new(1,1,1);b.BackgroundColor3=Color3.fromRGB(55,55,65)
	Instance.new("UICorner",b).CornerRadius=UDim.new(1,0)

	local function update()
		local on=get()
		b.Text=on and "ON" or "OFF"
		b.BackgroundColor3=on and Color3.fromRGB(50,180,100) or Color3.fromRGB(55,55,65)
	end

	b.MouseButton1Click:Connect(function()
		set(not get());update()
	end)

	update()
end

local function slider(name,min,max,val,fn)
	local box=Instance.new("Frame",C)
	box.Size=UDim2.new(1,-5,0,62);box.BackgroundColor3=Color3.fromRGB(24,24,33)
	Instance.new("UICorner",box).CornerRadius=UDim.new(0,11)

	local text=Instance.new("TextLabel",box)
	text.Size=UDim2.new(1,-20,0,25);text.Position=UDim2.fromOffset(10,2)
	text.BackgroundTransparency=1;text.Text=name..": "..val
	text.TextColor3=Color3.new(1,1,1);text.TextSize=14;text.Font=Enum.Font.GothamBold
	text.TextXAlignment=Enum.TextXAlignment.Left

	local bar=Instance.new("Frame",box)
	bar.Size=UDim2.new(1,-25,0,8);bar.Position=UDim2.fromOffset(12,40)
	bar.BackgroundColor3=Color3.fromRGB(55,55,65)
	Instance.new("UICorner",bar).CornerRadius=UDim.new(1,0)

	local fill=Instance.new("Frame",bar)
	fill.Size=UDim2.new((val-min)/(max-min),0,1,0)
	fill.BackgroundColor3=Color3.fromRGB(80,170,255)
	Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0)

	local drag=false

	local function set(x)
		local a=math.clamp((x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1)
		local v=math.floor(min+(max-min)*a)
		fill.Size=UDim2.new(a,0,1,0)
		text.Text=name..": "..v
		fn(v)
	end

	box.InputBegan:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then
			drag=true;set(i.Position.X)
		end
	end)

	UIS.InputChanged:Connect(function(i)
		if drag and(i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseMovement)then
			set(i.Position.X)
		end
	end)

	UIS.InputEnded:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end
	end)
end

local function movement()
	clear()

	slider("⚡ Speed",1,100,16,function(v)
		local h=hum()
		if h then h.WalkSpeed=v end
	end)

	slider("🦘 Jump",1,200,50,function(v)
		local h=hum()
		if h then h.JumpPower=v end
	end)

	slider("🕊️ Fly Speed",20,150,60,function(v)
		flySpeed=v
	end)

	toggle("🕊️ Fly",function()return fly end,function(v)
		fly=v
		if not v and bv then bv:Destroy();bv=nil end
	end)

	toggle("🚧 NoClip",function()return noclip end,function(v)noclip=v end)
	toggle("🏃 Auto Run",function()return autorun end,function(v)autorun=v end)
	toggle("🦘 Auto Jump",function()return autojump end,function(v)autojump=v end)
end

local function visual()
	clear()

	toggle("👁️ Highlight Players",function()return highlight end,function(v)
		highlight=v
		for _,p in ipairs(P:GetPlayers())do
			if p~=plr and p.Character then
				local h=p.Character:FindFirstChild("AdminHighlight")
				if v then
					h=h or Instance.new("Highlight",p.Character)
					h.Name="AdminHighlight"
				elseif h then h:Destroy()end
			end
		end
	end)

	toggle("👻 Invisible",function()return invisible end,function(v)
		invisible=v
		local c=plr.Character
		if c then
			for _,x in ipairs(c:GetDescendants())do
				if x:IsA("BasePart") then
					x.LocalTransparencyModifier=v and 1 or 0
				end
			end
		end
	end)
end

local function fun()
	clear()

	toggle("🔄 Spin",function()return spin end,function(v)spin=v end)

	toggle("🌍 Low Gravity",function()return gravity end,function(v)
		gravity=v
		workspace.Gravity=v and 50 or 196.2
	end)

	toggle("🤖 AI Bot",function()return ai end,function(v)
		ai=v
	end)
end

local function tab(name,x,fn)
	local b=Instance.new("TextButton",Tabs)
	b.Size=UDim2.fromOffset(90,34);b.Position=UDim2.fromOffset(x,0)
	b.Text=name;b.TextSize=13;b.Font=Enum.Font.GothamBold
	b.TextColor3=Color3.new(1,1,1);b.BackgroundColor3=Color3.fromRGB(30,30,40)
	Instance.new("UICorner",b).CornerRadius=UDim.new(0,8)
	b.MouseButton1Click:Connect(fn)
end

tab("Movement",0,movement)
tab("Visual",95,visual)
tab("Fun",190,fun)
movement()

--------------------------------------------------
-- FLY
--------------------------------------------------

RS.RenderStepped:Connect(function()
	local r=root()
	if fly and r then
		if not bv then
			bv=Instance.new("BodyVelocity",r)
			bv.MaxForce=Vector3.new(1e6,1e6,1e6)
		end

		local cam=workspace.CurrentCamera
		bv.Velocity=cam.CFrame.LookVector*flySpeed
	elseif bv then
		bv:Destroy()
		bv=nil
	end
end)

--------------------------------------------------
-- NOCLIP / AUTO JUMP / SPIN / RUN
--------------------------------------------------

RS.Stepped:Connect(function()
	local c=plr.Character
	local h=hum()
	local r=root()

	if noclip and c then
		for _,v in ipairs(c:GetDescendants())do
			if v:IsA("BasePart")then v.CanCollide=false end
		end
	end

	if autorun and h and r then
		h:Move(workspace.CurrentCamera.CFrame.LookVector)
	end

	if autojump and h then
		h.Jump=true
	end

	if spin and r then
		r.CFrame=r.CFrame*CFrame.Angles(0,math.rad(5),0)
	end
end)

