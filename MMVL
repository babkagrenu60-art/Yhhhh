local player=Players.LocalPlayer
local character=player.Character or player.CharacterAdded:Wait()
local humanoid=character:WaitForChild("Humanoid")
local rootPart=character:WaitForChild("HumanoidRootPart")

-- ========== ПОИСК ПРЕДМЕТОВ (АВТОМАТИЧЕСКИ) ==========
function findPistol()
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Tool") or obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name:find("pistol") or name:find("gun") or name:find("weapon") or 
               name:find("handgun") or name:find("shoot") or name:find("пистолет") then
                return obj
            end
        end
    end
    return nil
end

function findKnife()
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Tool") or obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name:find("knife") or name:find("blade") or name:find("dagger") or 
               name:find("melee") or name:find("нож") then
                return obj
            end
        end
    end
    return nil
end

