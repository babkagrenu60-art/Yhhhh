-- ========== ВКЛАДКА 3: УБИЙЦА ==========
local tab3,section3=createTab("🔴 Убийца",Color3.fromRGB(255,50,50))
tab3.Position=UDim2.new(0.66,2,0,2)

y=10
createButton(section3,"💀 Kill Aura",y,Color3.fromRGB(200,0,0),function()
    for _,plr in pairs(Players:GetPlayers()) do
        if plr~=player and plr.Character then
            local dist=(rootPart.Position-plr.Character.HumanoidRootPart.Position).Magnitude
            if dist<15 then
                if plr.Character:FindFirstChild("Humanoid") then
                    plr.Character.Humanoid.Health=0
                    print("💀 Убит:",plr.Name)
                end
            end
        end
    end
end)

createButton(section3,"🏃 Охранять пистолет",y+50,Color3.fromRGB(220,50,50),function()
    local pistol=findPistol()
    if pistol then
        local pos=rootPart.CFrame
        if pistol:IsA("BasePart") then
            rootPart.CFrame=pistol.CFrame*CFrame.new(0,2,3)
        else
            local handle=pistol:FindFirstChild("Handle") or pistol:FindFirstChild("MainPart")
            if handle then rootPart.CFrame=handle.CFrame*CFrame.new(0,2,3) end
        end
        task.wait(0.3)
        for _,plr in pairs(Players:GetPlayers()) do
            if plr~=player and plr.Character then
                local dist=(rootPart.Position-plr.Character.HumanoidRootPart.Position).Magnitude
                if dist<5 and plr.Character:FindFirstChild("Humanoid") then
                    plr.Character.Humanoid.Health=0
                    print("💀 Убит у пистолета:",plr.Name)
                end
            end
        end
        task.wait(0.3)
        rootPart.CFrame=pos
    else
        print("❌ Пистолет не найден!")
    end
end)

-- ========== ПЕРЕКЛЮЧЕНИЕ ВКЛАДОК ==========
function switchTab(tab,section)
    for _,s in pairs(sections) do
        s.Visible=false
        s.Size=UDim2.new(1,0,0,0)
    end
    for _,t in pairs(tabBar:GetChildren()) do
        if t:IsA("TextButton") then t.BackgroundColor3=Color3.fromRGB(35,35,40) end
    end
    section.Visible=true
    section.Size=UDim2.new(1,0,0,500)
    tab.BackgroundColor3=Color3.fromRGB(55,55,65)
end

tab1.MouseButton1Click:Connect(function() switchTab(tab1,section1) end)
tab2.MouseButton1Click:Connect(function() switchTab(tab2,section2) end)
tab3.MouseButton1Click:Connect(function() switchTab(tab3,section3) end)

switchTab(tab1,section1)

