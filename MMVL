local sections={}

function createTab(name,color)
    local btn=Instance.new("TextButton")
    btn.Size=UDim2.new(0.33,-2,1,-4)
    btn.Position=UDim2.new(0,2,0,2)
    btn.BackgroundColor3=Color3.fromRGB(35,35,40)
    btn.Text=name
    btn.TextColor3=color
    btn.TextScaled=true
    btn.Font=Enum.Font.GothamBold
    btn.BorderSizePixel=0
    btn.Parent=tabBar
    
    local section=Instance.new("Frame")
    section.Size=UDim2.new(1,0,0,0)
    section.BackgroundTransparency=1
    section.Visible=false
    section.Parent=contentFrame
    sections[btn]=section
    return btn,section
end

function createButton(parent,text,yPos,color,callback)
    local btn=Instance.new("TextButton")
    btn.Size=UDim2.new(0.95,0,0,40)
    btn.Position=UDim2.new(0.025,0,0,yPos)
    btn.BackgroundColor3=color or Color3.fromRGB(50,50,60)
    btn.Text=text
    btn.TextColor3=Color3.fromRGB(255,255,255)
    btn.TextScaled=true
    btn.Font=Enum.Font.GothamMedium
    btn.BorderSizePixel=0
    btn.Parent=parent
    local btnCorner=Instance.new("UICorner")
    btnCorner.CornerRadius=UDim.new(0,8)
    btnCorner.Parent=btn
    btn.MouseButton1Click:Connect(function()
        btn.BackgroundColor3=Color3.fromRGB(150,150,150)
        task.wait(0.1)
        btn.BackgroundColor3=color or Color3.fromRGB(50,50,60)
        if callback then callback() end
    end)
    return btn
end

-- ========== ВКЛАДКА 1: НЕВИНОВНЫЙ ==========
local tab1,section1=createTab("🟢 Невиновный",Color3.fromRGB(0,255,0))
tab1.Position=UDim2.new(0,2,0,2)

local y=10
createButton(section1,"🔫 Авто подбор пистолета",y,Color3.fromRGB(0,180,0),function()
    local pistol=findPistol()
    if pistol then
        local pos=rootPart.CFrame
        if pistol:IsA("BasePart") then
            rootPart.CFrame=pistol.CFrame*CFrame.new(0,2,2)
        else
            local handle=pistol:FindFirstChild("Handle") or pistol:FindFirstChild("MainPart")
            if handle then rootPart.CFrame=handle.CFrame*CFrame.new(0,2,2) end
        end
        task.wait(0.3)
        rootPart.CFrame=pos
        print("✅ Пистолет подобран!")
    else
        print("❌ Пистолет не найден!")
    end
end)

createButton(section1,"🛡️ Уклонение (Манс)",y+50,Color3.fromRGB(0,150,100),function()
    local randomDir=Vector3.new(math.random(-15,15),0,math.random(-15,15))
    rootPart.CFrame=rootPart.CFrame*CFrame.new(randomDir)*CFrame.new(0,0,5)
    task.wait(0.1)
    rootPart.CFrame=rootPart.CFrame*CFrame.new(0,0,-5)
    print("✅ Уклонение!")
end)

