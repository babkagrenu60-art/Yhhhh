local P=game:GetService("Players")
local UIS=game:GetService("UserInputService")
local RS=game:GetService("RunService")
local PS=game:GetService("PathfindingService")
local plr=P.LocalPlayer

local gui=Instance.new("ScreenGui",plr:WaitForChild("PlayerGui"))
gui.Name="AdminPanel";gui.ResetOnSpawn=false

local F=Instance.new("Frame",gui)
F.Size=UDim2.fromOffset(310,360);F.Position=UDim2.new(.5,-155,.5,-180)
F.BackgroundColor3=Color3.fromRGB(12,12,18);Instance.new("UICorner",F).CornerRadius=UDim.new(0,18)
local S=Instance.new("UIStroke",F);S.Thickness=2

local T=Instance.new("TextLabel",F)
T.Size=UDim2.new(1,0,0,42);T.Text="⚡ ADMIN PANEL";T.TextSize=21;T.Font=Enum.Font.GothamBold
T.TextColor3=Color3.new(1,1,1);T.BackgroundTransparency=1

local Tabs=Instance.new("Frame",F);Tabs.Size=UDim2.new(1,-20,0,38);Tabs.Position=UDim2.fromOffset(10,45);Tabs.BackgroundTransparency=1
local C=Instance.new("ScrollingFrame",F);C.Size=UDim2.new(1,-20,1,-92);C.Position=UDim2.fromOffset(10,88)
C.BackgroundTransparency=1;C.ScrollBarThickness=3;C.AutomaticCanvasSize=Enum.AutomaticSize.Y
local L=Instance.new("UIListLayout",C);L.Padding=UDim.new(0,7)

local function hum()local c=plr.Character;return c and c:FindFirstChildOfClass("Humanoid")end
local function root()local c=plr.Character;return c and c:FindFirstChild("HumanoidRootPart")end
local function clear()for _,v in ipairs(C:GetChildren())do if v:IsA("GuiObject")then v:Destroy()end end end

local function button(t,fn)
	local b=Instance.new("TextButton",C);b.Size=UDim2.new(1,-5,0,42);b.Text=t;b.TextSize=15
	b.Font=Enum.Font.GothamBold;b.TextColor3=Color3.new(1,1,1);b.BackgroundColor3=Color3.fromRGB(28,28,38)
	Instance.new("UICorner",b).CornerRadius=UDim.new(0,10);b.MouseButton1Click:Connect(fn);return b
end

local function slider(name,min,max,value,fn)
	local box=Instance.new("Frame",C);box.Size=UDim2.new(1,-5,0,62);box.BackgroundColor3=Color3.fromRGB(24,24,32)
	Instance.new("UICorner",box).CornerRadius=UDim.new(0,10)
	local text=Instance.new("TextLabel",box);text.Size=UDim2.new(1,-20,0,25);text.Position=UDim2.fromOffset(10,3)
	text.BackgroundTransparency=1;text.Text=name..": "..value;text.TextColor3=Color3.new(1,1,1);text.Font=Enum.Font.GothamBold;text.TextSize=14
	local bar=Instance.new("Frame",box);bar.Size=UDim2.new(1,-25,0,8);bar.Position=UDim2.fromOffset(12,40);bar.BackgroundColor3=Color3.fromRGB(55,55,65)
	Instance.new("UICorner",bar).CornerRadius=UDim.new(1,0)
	local fill=Instance.new("Frame",bar);fill.Size=UDim2.new((value-min)/(max-min),0,1,0);fill.BackgroundColor3=Color3.fromRGB(100,180,255)
	Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0)
	local dragging=false
	local function set(x)
		local a=math.clamp((x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1)
		local v=math.floor(min+(max-min)*a)
		fill.Size=UDim2.new(a,0,1,0);text.Text=name..": "..v;fn(v)
	end
	box.InputBegan:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=true;set(i.Position.X)end
	end)
	UIS.InputChanged:Connect(function(i)
		if dragging and(i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseMovement)then set(i.Position.X)end
	end)
	UIS.InputEnded:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end
	end)
end

local fly=false
local noclip=false
local flySpeed=60
local bv

local function flyButton()
	fly=not fly
	if not fly and bv then bv:Destroy();bv=nil end
end

local function movement()
	clear()
	slider("⚡ Speed",1,100,16,function(v)local h=hum()if h then h.WalkSpeed=v end end)
	slider("🦘 Jump",1,200,50,function(v)local h=hum()if h then h.JumpPower=v end end)
	slider("🕊️ Fly Speed",20,150,60,function(v)flySpeed=v end)
	button(fly and "🕊️ FLY: ON" or "🕊️ FLY: OFF",flyButton)
	button(noclip and "🚧 NOCLIP: ON" or "🚧 NOCLIP: OFF",function()
		noclip=not noclip
	end)
	button("❤️ HEAL",function()local h=hum()if h then h.Health=h.MaxHealth end end)
	button("🔄 RESPAWN",function()local h=hum()if h then h.Health=0 end end)
end

local function visual()
	clear()
	button("👁️ HIGHLIGHT PLAYERS",function()
		for _,p in ipairs(P:GetPlayers())do
			if p~=plr and p.Character then
				local h=p.Character:FindFirstChild("AdminHighlight")or Instance.new("Highlight",p.Character)
				h.Name="AdminHighlight";h.Enabled=true
			end
		end
	end)
	button("❌ REMOVE HIGHLIGHTS",function()
		for _,p in ipairs(P:GetPlayers())do
			if p.Character then
				local h=p.Character:FindFirstChild("AdminHighlight")
				if h then h:Destroy()end
			end
		end
	end)
end

local function fun()
	clear()
	button("🤖 AI BOT",function()
		local h=hum();local r=root()
		if not h or not r then return end
		local p=PS:CreatePath({AgentCanJump=true,AgentCanClimb=true,WaypointSpacing=3})
		local pos=r.Position+Vector3.new(math.random(-60,60),0,math.random(-60,60))
		p:ComputeAsync(r.Position,pos)
		if p.Status==Enum.PathStatus.Success then
			for _,w in ipairs(p:GetWaypoints())do
				if w.Action==Enum.PathWaypointAction.Jump then h.Jump=true end
				h:MoveTo(w.Position);h.MoveToFinished:Wait()
			end
		end
	end)
	button("🦘 SUPER JUMP",function()local h=hum()if h then h.JumpPower=150;h.Jump=true end end)
	button("🏃 RESET STATS",function()local h=hum()if h then h.WalkSpeed=16;h.JumpPower=50 end end)
end

local function tab(t,x,fn)
	local b=Instance.new("TextButton",Tabs);b.Size=UDim2.fromOffset(90,34);b.Position=UDim2.fromOffset(x,0)
	b.Text=t;b.TextSize=13;b.Font=Enum.Font.GothamBold;b.TextColor3=Color3.new(1,1,1)
	b.BackgroundColor3=Color3.fromRGB(30,30,40);Instance.new("UICorner",b).CornerRadius=UDim.new(0,8)
	b.MouseButton1Click:Connect(fn)
end

tab("Movement",0,movement);tab("Visual",95,visual);tab("Fun",190,fun);movement()

local drag=false
local ds,sp
T.InputBegan:Connect(function(i)
	if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then drag=true;ds=i.Position;sp=F.Position end
end)
UIS.InputChanged:Connect(function(i)
	if drag and(i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseMovement)then
		local d=i.Position-ds
		F.Position=UDim2.new(sp.X.Scale,sp.X.Offset+d.X,sp.Y.Scale,sp.Y.Offset+d.Y)
	end
end)
UIS.InputEnded:Connect(function(i)
	if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end
end)

RS.Stepped:Connect(function()
	local c=plr.Character
	if noclip and c then
		for _,v in ipairs(c:GetDescendants())do if v:IsA("BasePart")then v.CanCollide=false end end
	end
end)

RS.RenderStepped:Connect(function()
	if fly and root() then
		if not bv then
			bv=Instance.new("BodyVelocity",root());bv.MaxForce=Vector3.new(1e6,1e6,1e6)
		end
		local cam=workspace.CurrentCamera
		bv.Velocity=cam.CFrame.LookVector*flySpeed
	elseif bv then
		bv:Destroy();bv=nil
	end
end)
