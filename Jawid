cTgl("KILL AURA (УБИЙЦА)", UDim2.new(0,15,0,60), CP, function(v)
	_G.KA = v; while _G.KA do task.wait(0.1)
		local k = LP.Character and LP.Character:FindFirstChild("Knife")
