-- ЛОГИКА СИСТЕМЫ ЕСП (ЦВЕТНЫЕ РОЛИ ДЛЯ DELTA)
R.RenderStepped:Connect(function()
	for _, p in pairs(P:GetPlayers()) do if p ~= LP and p.Character and p.Character:FindFirstChild("Head") then
		local h = p.Character:FindFirstChildOfClass("Highlight")
		if EAll then if not h then h = Instance.new("Highlight", p.Character) end
			local isM = p.Character:FindFirstChild("Knife") or p.Backpack:FindFirstChild("Knife")
			local isS = p.Character:FindFirstChild("Gun") or p.Backpack:FindFirstChild("Gun")
			h.FillColor = isM and Color3.fromRGB(200,50,50) or (isS and Color3.fromRGB(50,50,200) or Color3.fromRGB(255,255,255))
			h.Enabled = true
		elseif h then h.Enabled = false end
		local bb = p.Character.Head:FindFirstChild("EspInfo")
		if bb and bb:FindFirstChildOfClass("TextLabel") then local tl = bb:FindFirstChildOfClass("TextLabel")
			if SInf and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
				tl.Text = p.Name .. " [" .. math.floor((LP.Character.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude) .. "m]"; tl.Visible = true
			else tl.Visible = false end
		end
	end end
	local gunPart = workspace:FindFirstChild("Gun") or workspace:FindFirstChild("GunDrop")
	if gunPart and gunPart:IsA("BasePart") then local gh = gunPart:FindFirstChildOfClass("SelectionBox") if EGun then if not gh then gh = Instance.new("SelectionBox", gunPart); gh.Color3 = Color3.fromRGB(255,255,255) end gh.Adornee = gunPart; gh.Visible = true else if gh then gh.Visible = false end end end
	if NClp and LP.Character then for _, part in pairs(LP.Character:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end end
end)

U.JumpRequest:Connect(function() if WHop and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
	local hrp = LP.Character.HumanoidRootPart; local r = Ray.new(hrp.Position, hrp.CFrame.LookVector * 3)
	if workspace:FindPartOnRay(r, LP.Character) and LP.Character:FindFirstChildOfClass("Humanoid") then hrp.Velocity = Vector3.new(hrp.Velocity.X, 52, hrp.Velocity.Z) end
end end)
