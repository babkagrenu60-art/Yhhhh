local function cTab(name, pos, frame)
	local b = Instance.new("TextButton"); b.Size = UDim2.new(1, 0, 0, 50); b.Position = pos; b.BackgroundColor3 = Color3.fromRGB(20, 20, 20); b.Text = name; b.TextColor3 = Color3.fromRGB(150, 150, 150); b.Font = Enum.Font.GothamBold; b.TextSize = 13; b.Parent = LT
	b.MouseButton1Click:Connect(function()
		CE.Visible, CP.Visible, CL.Visible = false, false, false; frame.Visible = true
		for _, x in pairs(LT:GetChildren()) do if x:IsA("TextButton") then x.BackgroundColor3 = Color3.fromRGB(20, 20, 20); x.TextColor3 = Color3.fromRGB(150, 150, 150) end end
		b.BackgroundColor3 = Color3.fromRGB(30, 30, 30); b.TextColor3 = Color3.fromRGB(255, 255, 255)
	end); return b
end
local tE = cTab("ЕСП", UDim2.new(0,0,0,0), CE); tE.BackgroundColor3 = Color3.fromRGB(30, 30, 30); tE.TextColor3 = Color3.fromRGB(255, 255, 255)
