local function cStat(t, pos, mode)
	local b = Instance.new("TextButton"); b.Size = UDim2.new(0, 105, 0, 30); b.Position = pos; b.BackgroundColor3 = Color3.fromRGB(35, 35, 35); b.Text = t; b.TextColor3 = Color3.fromRGB(200, 200, 200); b.Font = Enum.Font.GothamBold; b.TextSize = 10; b.Parent = CL
	b.MouseButton1Click:Connect(function() local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") if h then if mode == "S" then h.WalkSpeed = h.WalkSpeed == 16 and 45 or 16; b.Text = h.WalkSpeed == 45 and "СКОРОСТЬ: Х45" or "СКОРОСТЬ: СТАНД" else h.JumpPower = h.JumpPower == 50 and 90 or 50; b.Text = h.JumpPower == 90 and "ПРЫЖОК: Х90" or "ПРЫЖОК: СТАНД" end end end)
end
