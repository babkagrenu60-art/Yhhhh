-- Открытие/закрытие с анимацией
Icon.MouseButton1Click:Connect(function()
    if MF.Visible then
        local t=TW:Create(MF,TweenInfo.new(0.25,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{
            Size=UDim2.new(0,0,0,0)
        })
        t:Play()
        t.Completed:Connect(function() MF.Visible=false end)
    else
        MF.Visible=true
        MF.Size=UDim2.new(0,0,0,0)
        TW:Create(MF,TweenInfo.new(0.35,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{
            Size=CFG.Size
        }):Play()
    end
end)

CB.MouseButton1Click:Connect(function()
    local t=TW:Create(MF,TweenInfo.new(0.25),{Size=UDim2.new(0,0,0,0)})
    t:Play()
    t.Completed:Connect(function() MF.Visible=false end)
end)

-- Перетаскивание
do
    local d,ds,sp=false,nil,nil
    TB.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            d=true
            ds=i.Position
            sp=MF.Position
            i.Changed:Connect(function()
                if i.UserInputState==Enum.UserInputState.End then d=false end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if d and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
            local dd=i.Position-ds
            MF.Position=UDim2.new(sp.X.Scale,sp.X.Offset+dd.X,sp.Y.Scale,sp.Y.Offset+dd.Y)
        end
    end)
end

-- Горячие клавиши
UIS.InputBegan:Connect(function(input,gpe)
    if gpe then return end
    if input.KeyCode==Enum.KeyCode.Q then
        for _,plr in ipairs(Players:GetPlayers()) do
            if plr~=LP then
                local role=getRole(plr)
                if role=="Sheriff" and plr.Character then
                    local shrp=plr.Character:FindFirstChild("HumanoidRootPart")
                    local _,_,hrp=getChar()
                    if shrp and hrp then
                        hrp.CFrame=CFrame.new(shrp.Position+Vector3.new(0,3,0))
                    end
                    break
                end
            end
        end
    elseif input.KeyCode==Enum.KeyCode.E then
        local _,_,hrp=getChar()
        if hrp then hrp.CFrame=CFrame.new(0,50,0) end
    elseif input.KeyCode==Enum.KeyCode.R then
        for plr,hl in pairs(espHighlights) do
            if hl then hl:Destroy() end
            espHighlights[plr]=nil
        end
    elseif input.KeyCode==Enum.KeyCode.F then
        for _,plr in ipairs(Players:GetPlayers()) do
            local role=getRole(plr)
            print(plr.Name,"->",role)
        end
    end
end)

LP.CharacterAdded:Connect(function()
    task.wait(2)
    for plr,hl in pairs(espHighlights) do
        if hl then hl:Destroy() end
        espHighlights[plr]=nil
    end
end)

