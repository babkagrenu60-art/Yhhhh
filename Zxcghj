local ESPFolder=Instance.new("Folder")
ESPFolder.Name="MM2_ESP"
ESPFolder.Parent=SG

local espHighlights={}

local function getRole(plr)
    local c=plr.Character
    if not c then return "—",Color3.fromRGB(120,120,140) end
    for _,tag in ipairs{"Murderer","Sheriff","Innocent","Hero"} do
        if c:FindFirstChild(tag) then
            local col=tag=="Murderer" and Color3.fromRGB(255,50,50)
                or tag=="Sheriff" and Color3.fromRGB(50,150,255)
                or Color3.fromRGB(80,255,120)
            return tag,col
        end
    end
    local r=c:GetAttribute("Role") or plr:GetAttribute("Role")
    if r then
        local col=r=="Murderer" and Color3.fromRGB(255,50,50)
            or r=="Sheriff" and Color3.fromRGB(50,150,255)
            or Color3.fromRGB(80,255,120)
        return tostring(r),col
    end
    return "—",Color3.fromRGB(120,120,140)
end

local function createESP(plr,color)
    if espHighlights[plr] then
        espHighlights[plr]:Destroy()
    end
    local hl=Instance.new("Highlight")
    hl.FillColor=color
    hl.OutlineColor=Color3.fromRGB(255,255,255)
    hl.FillTransparency=0.5
    hl.OutlineTransparency=0.1
    hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee=plr.Character
    hl.Parent=ESPFolder
    espHighlights[plr]=hl
    return hl
end

local function updateESP()
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=LP and plr.Character then
            local role,col=getRole(plr)
            if role=="Murderer" and CFG.ESPMurderer then
                if not espHighlights[plr] then createESP(plr,col) end
                espHighlights[plr].Adornee=plr.Character
                espHighlights[plr].FillColor=col
            elseif role=="Sheriff" and CFG.ESPSheriff then
                if not espHighlights[plr] then createESP(plr,col) end
                espHighlights[plr].Adornee=plr.Character
                espHighlights[plr].FillColor=col
            elseif role=="Innocent" and CFG.ESPInnocent then
                if not espHighlights[plr] then createESP(plr,col) end
                espHighlights[plr].Adornee=plr.Character
                espHighlights[plr].FillColor=col
            else
                if espHighlights[plr] then
                    espHighlights[plr]:Destroy()
                    espHighlights[plr]=nil
                end
            end
        else
            if espHighlights[plr] then
                espHighlights[plr]:Destroy()
                espHighlights[plr]=nil
            end
        end
    end
end

RS.Heartbeat:Connect(updateESP)

