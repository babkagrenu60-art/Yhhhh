-- Логика клика по кнопке Issuance
IssuanceBtn.MouseButton1Click:Connect(function()
    if NickInput.Text == "" then 
        NickInput.PlaceholderText = "PLEASE ENTER NICKNAME!"
        return 
    end
    
    -- Показываем экран загрузки геймпасса
    ModalOverlay.Visible = true
    TweenService:Create(ModalOverlay, TransitionInfo, {BackgroundTransparency = 0.5}):Play()
    
    -- Фаза 1 (0-1 сек)
    StatusLabel.Text = "Purchasing Gamepass Asset..."
    task.wait(1.2)
    
    -- Фаза 2 (1-2 сек)
    StatusLabel.Text = "Transferring " .. tostring(RobuxAmounts[currentSelectionIndex]) .. " R$ to " .. NickInput.Text .. "..."
    task.wait(1.3)
    
    -- Фаза 3 (2-3 сек)
    StatusLabel.Text = "Success! Clearing cache..."
    task.wait(0.5)
    
    -- Скрываем загрузку
    ModalOverlay.BackgroundTransparency = 1
    ModalOverlay.Visible = false
    
    -- Создаем красивое официальное уведомление
    local SuccessNotification = Instance.new("Frame")
    SuccessNotification.Size = UDim2.new(0, 300, 0, 60)
    SuccessNotification.Position = UDim2.new(0.5, -150, 0, -70)
    SuccessNotification.BackgroundColor3 = Color3.fromRGB(0, 180, 100)
    SuccessNotification.ZIndex = 20
    SuccessNotification.Parent = ScreenGui
    
    local NotifCorner = Instance.new("UICorner")
    NotifCorner.CornerRadius = UDim.new(0, 6)
    NotifCorner.Parent = SuccessNotification
    
    local NotifText = Instance.new("TextLabel")
    NotifText.Size = UDim2.new(1, 0, 1, 0)
    NotifText.BackgroundTransparency = 1
    NotifText.TextColor3 = Color3.fromRGB(255, 255, 255)
