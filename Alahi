-- Логика динамического поиска игрока и загрузки его аватарки
NickInput:GetPropertyChangedSignal("Text"):Connect(function()
    local text = NickInput.Text
    if text == "" then
        ProfileFrame.BackgroundTransparency = 1
        AvatarImage.Visible = false
        NickLabel.Text = ""
        return
    end
    
    -- Пытаемся найти ID игрока по нику
    task.spawn(function()
        local success, userId = pcall(function()
            return Players:GetUserIdFromNameAsync(text)
        end)
        
        if success and userId and NickInput.Text == text then
            ProfileFrame.BackgroundTransparency = 0
            NickLabel.Text = text
            AvatarImage.Image = "rbxthumb://type=AvatarHeadShot&id="..userId.."&w=150&h=150"
            AvatarImage.Visible = true
        end
    end)
end)

