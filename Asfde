-- Функция включения/выключения полёта
local function toggleFly()
    flying = not flying
    
    if flying then
        -- Включение полёта
        flyButton.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
        flyButton.Text = "FLY: ON"
        
        -- Показать кнопки управления
        upButton.Visible = true
        downButton.Visible = true
        leftButton.Visible = true
        rightButton.Visible = true
        forwardButton.Visible = true
        backwardButton.Visible = true
        
        -- Увеличить размер панели
        mainFrame.Size = UDim2.new(0, 250, 0, 350)
        
        bodyGyro = Instance.new("BodyGyro")
        bodyGyro.P = 9e4
        bodyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
        bodyGyro.CFrame = character.HumanoidRootPart.CFrame
        bodyGyro.Parent = character.HumanoidRootPart
        
        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bodyVelocity.Parent = character.HumanoidRootPart
        
        humanoid.PlatformStand = true
    else
        -- Выключение полёта
        flyButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        flyButton.Text = "FLY: OFF"
        
        -- Скрыть кнопки управления
        upButton.Visible = false
        downButton.Visible = false
        leftButton.Visible = false
        rightButton.Visible = false
        forwardButton.Visible = false
        backwardButton.Visible = false
        
        -- Уменьшить размер панели
        mainFrame.Size = UDim2.new(0, 250, 0, 100)
        
        if bodyGyro then
            bodyGyro:Destroy()
            bodyGyro = nil
        end
        
        if bodyVelocity then
            bodyVelocity:Destroy()
            bodyVelocity = nil
        end
        
        humanoid.PlatformStand = false
        moveDirection = Vector3.new(0, 0, 0)
    end
end

-- Управление кнопками
local function handleButtonPress(button, direction)
    local isPressed = false
    
    button.MouseButton1Down:Connect(function()
        isPressed = true
        moveDirection = moveDirection + direction
    end)
    
    button.MouseButton1Up:Connect(function()
        isPressed = false
        moveDirection = moveDirection - direction
    end)
    
    button.MouseLeave:Connect(function()
        if isPressed then
            isPressed = false
            moveDirection = moveDirection - direction
        end
    end)
end

-- Назначение кнопок
handleButtonPress(upButton, Vector3.new(0, 1, 0))
handleButtonPress(downButton, Vector3.new(0, -1, 0))
handleButtonPress(leftButton, Vector3.new(-1, 0, 0))
handleButtonPress(rightButton, Vector3.new(1, 0, 0))
handleButtonPress(forwardButton, Vector3.new(0, 0, -1))
handleButtonPress(backwardButton, Vector3.new(0, 0, 1))

-- Обновление движения
game:GetService("RunService").RenderStepped:Connect(function()
    if flying and bodyVelocity and bodyGyro then
        local direction = Vector3.new()
        local camera = workspace.CurrentCamera
        
        if moveDirection.X ~= 0 then
            direction = direction + camera.CFrame.RightVector * moveDirection.X
        end
        if moveDirection.Z ~= 0 then
            direction = direction - camera.CFrame.LookVector * moveDirection.Z
        end
        direction = direction + Vector3.new(0, moveDirection.Y, 0)
        
        bodyVelocity.Velocity = direction * speed
        bodyGyro.CFrame = camera.CFrame
    end
end)

-- Кнопки
flyButton.MouseButton1Click:Connect(toggleFly)
closeButton.MouseButton1Click:Connect(function()
    mainFrame.Visible = false
    openButton.Visible = true
end)

openButton.MouseButton1Click:Connect(function()
    mainFrame.Visible = true
    openButton.Visible = false
end)

-- Если персонаж возрождается
player.CharacterAdded:Connect(function(newCharacter)
    character = newCharacter
    humanoid = character:WaitForChild("Humanoid")
    flying = false
    flyButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    flyButton.Text = "FLY: OFF"
    upButton.Visible = false
    downButton.Visible = false
    leftButton.Visible = false
    rightButton.Visible = false
    forwardButton.Visible = false
    backwardButton.Visible = false
    mainFrame.Size = UDim2.new(0, 250, 0, 100)
end)
