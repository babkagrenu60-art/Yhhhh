-- Функция создания кнопок управления
local function createControlButton(text, position, color)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0, 60, 0, 60)
    button.Position = position
    button.BackgroundColor3 = color
    button.Text = text
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 24
    button.BorderSizePixel = 0
    button.Visible = false
    button.Parent = mainFrame
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 10)
    btnCorner.Parent = button
    
    return button
end

-- Кнопки управления
local upButton = createControlButton("↑", UDim2.new(0.5, -30, 0, 100), Color3.fromRGB(50, 50, 50))
local downButton = createControlButton("↓", UDim2.new(0.5, -30, 0, 230), Color3.fromRGB(50, 50, 50))
local leftButton = createControlButton("←", UDim2.new(0.5, -95, 0, 165), Color3.fromRGB(50, 50, 50))
local rightButton = createControlButton("→", UDim2.new(0.5, 35, 0, 165), Color3.fromRGB(50, 50, 50))
local forwardButton = createControlButton("▲", UDim2.new(0.15, 0, 0, 165), Color3.fromRGB(0, 100, 255))
local backwardButton = createControlButton("▼", UDim2.new(0.7, 0, 0, 165), Color3.fromRGB(0, 100, 255))

