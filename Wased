local function updateCharacter()
    character = player.Character
    if character then
        humanoid = character:FindFirstChild("Humanoid")
        rootPart = character:FindFirstChild("HumanoidRootPart")
        return humanoid ~= nil and rootPart ~= nil
    end
    return false
end

player.CharacterAdded:Connect(function()
    updateCharacter()
end)

-- ============================================================
--  WALLHOP ЛОГИКА
-- ============================================================

local function getWallNormal()
    if not rootPart then return nil end
    local rayOrigin = rootPart.Position
    local rayDirection = rootPart.CFrame.LookVector * -1  -- Смотрим назад

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    rayParams.FilterDescendantsInstances = {character}

    local raycastResult = workspace:Raycast(rayOrigin, rayDirection * 5, rayParams)
    if raycastResult then
        return raycastResult.Normal
    end
    return nil
end

local function wallhop()
    if not wallhopEnabled then return end
    if not humanoid or not rootPart then return end

    -- Проверяем, что персонаж в воздухе (прыгает) и рядом есть стена
    if humanoid:GetState() == Enum.HumanoidStateType.Jumping or humanoid:GetState() == Enum.HumanoidStateType.Freefall then
        local wallNormal = getWallNormal()
        if wallNormal then
            -- Отталкиваемся от стены вверх и в сторону
            local jumpDirection = wallNormal * 25 + Vector3.new(0, 25, 0)
            rootPart.Velocity = jumpDirection
            humanoid.Jump = true
            
            -- Быстрый поворот вправо и обратно
            local currentCFrame = rootPart.CFrame
            rootPart.CFrame = currentCFrame * CFrame.Angles(0, math.rad(15), 0)  -- Поворот вправо
            task.wait(0.05)
            rootPart.CFrame = currentCFrame * CFrame.Angles(0, math.rad(-15), 0) -- Обратно
            
            -- Плавный поворот к стене (опционально)
            rootPart.CFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + wallNormal)
        end
    end
end

