-- ССЫЛКИ НА ПЕРСОНАЖА
local function getChar()
    local c=LP.Character
    if not c then return nil,nil end
    local h=c:FindFirstChildOfClass("Humanoid")
    local hrp=c:FindFirstChild("HumanoidRootPart")
    if not h or not hrp then return nil,nil end
    return h,hrp
end

-- СБОР ЧЕКПОИНТОВ
local function collectCheckpoints()
    local list={}
    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n=obj.Name:lower()
            if obj:IsA("SpawnLocation") or n:find("checkpoint") or n:find("finish") or n:find("goal") or n:find("stage") then
                table.insert(list,obj)
            end
        end
    end
    table.sort(list,function(a,b) return a.Position.Y<b.Position.Y end)
    return list
end

-- ВЫБОР СЛЕДУЮЩЕЙ ЦЕЛИ
local function pickNextTarget()
    local cps=collectCheckpoints()
    if #cps==0 then return nil end
    local _,hrp=getChar()
    if not hrp then return nil end
    local myPos=hrp.Position
    local best,bestScore=nil,math.huge
    for _,cp in ipairs(cps) do
        local d=(cp.Position-myPos).Magnitude
        local score=d-(cp.Position.Y-myPos.Y)*0.5
        if score<bestScore then bestScore=score;best=cp end
    end
    return best
end

-- ПОСТРОЕНИЕ ПУТИ
local function buildPath(targetPos)
    local path=PathfindingService:CreatePath(agentParams)
    local _,hrp=getChar()
    if not hrp then return nil end
    local ok,err=pcall(function()
        path:ComputeAsync(hrp.Position,targetPos)
    end)
    if not ok then return nil end
    if path.Status~=Enum.PathStatus.Success then return nil end
    return path
end

-- ПРОВЕРКА ПРЫЖКА
local function shouldJump(wp)
    local h,hrp=getChar()
    if not h or not hrp then return false end
    if wp.Action==Enum.PathfindingWaypointAction.Jump then return true end
    local diff=wp.Position.Y-hrp.Position.Y
    if diff>2 then return true end
    return false
end

-- ДВИЖЕНИЕ К ТОЧКЕ
local function moveTo(wp)
    local h,hrp=getChar()
    if not h or not hrp then return false end
    local pos=wp.Position
    if shouldJump(wp) and h.FloorMaterial~=Enum.Material.Air then
        h.Jump=true
    end
    h:MoveTo(pos)
    local start=tick()
    while tick()-start<5 do
        h,hrp=getChar()
        if not h or not hrp then return false end
        local dist=(hrp.Position-pos).Magnitude
        if dist<CONFIG.JumpThreshold then return true end
        if tick()-lastProgress>CONFIG.StuckTimeLimit then return false end
        task.wait(0.05)
    end
    return false
end

-- ЗАЩИТА ОТ ЗАСТРЕВАНИЯ
local function checkStuck()
    local _,hrp=getChar()
    if not hrp then return false end
    if not lastPos then lastPos=hrp.Position;return false end
    local moved=(hrp.Position-lastPos).Magnitude
    if moved>CONFIG.StuckDistance then
        lastPos=hrp.Position
        lastProgress=tick()
        return false
    end
    if tick()-lastProgress>CONFIG.StuckTimeLimit then return true end
    return false
end

-- ТОЛЧОК
local function pushForward()
    local h,hrp=getChar()
    if not h or not hrp then return end
    local dir=hrp.CFrame.LookVector
    hrp.AssemblyLinearVelocity=dir*CONFIG.PushForce+Vector3.new(0,20,0)
    h.Jump=true
end

-- ПЕРЕСЧЁТ
local function repath()
    local now=tick()
    if now-lastRepath<CONFIG.RepathCooldown then return end
    lastRepath=now
    if not currentTarget then currentTarget=pickNextTarget() end
    if not currentTarget then return end
    retries=retries+1
    if retries>CONFIG.MaxRetries then
        currentTarget=pickNextTarget()
        retries=0
        return
    end
    local p=buildPath(currentTarget.Position)
    if p then
        currentPath=p
        waypoints=p:GetWaypoints()
        wpIndex=2
        retries=0
    end
end

-- ОСНОВНОЙ ЦИКЛ
local function startLoop()
    if mainLoop then mainLoop:Disconnect() end
    mainLoop=task.spawn(function()
        while active do
            task.wait(0.1)
            local h,hrp=getChar()
            if not h or not hrp then task.wait(1);continue end

            if checkStuck() then
                StatusLbl.Text="Застрял · пересчёт..."
                StatusLbl.TextColor3=Color3.fromRGB(255,200,80)
                pushForward()
                task.wait(0.3)
                repath()
                StatusLbl.Text="Работаю"
                StatusLbl.TextColor3=Color3.fromRGB(100,255,180)
            end

            if not currentPath or wpIndex>#waypoints then
                currentTarget=pickNextTarget()
                if not currentTarget then
                    StatusLbl.Text="Нет чекпоинтов"
                    StatusLbl.TextColor3=Color3.fromRGB(255,120,120)
                    task.wait(2)
                    continue
                end
                local dist=(currentTarget.Position-hrp.Position).Magnitude
                if dist<5 then
                    currentTarget=pickNextTarget()
                    task.wait(0.5)
                    continue
                end
                currentPath=buildPath(currentTarget.Position)
                if currentPath then
                    waypoints=currentPath:GetWaypoints()
                    wpIndex=2
                else
                    task.wait(1)
                    continue
                end
            end

            local wp=waypoints[wpIndex]
            if wp then
                moveTo(wp)
                wpIndex=wpIndex+1
            end
        end
    end)
end

