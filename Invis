-- // ================= АНИМАЦИИ GUI =================
local function openGui()
    MainFrame:TweenSize(
        CONFIG.GuiSize,
        Enum.EasingDirection.Out,
        Enum.EasingStyle.Back,
        0.4,
        true
    )
end

local function closeGui()
    MainFrame:TweenSize(
        UDim2.new(0, 0, 0, 0),
        Enum.EasingDirection.In,
        Enum.EasingStyle.Quad,
        0.25,
        true
    )
end

openGui()
CloseBtn.MouseButton1Click:Connect(closeGui)

-- // ================= ПЕРЕТАСКИВАНИЕ =================
local dragging = false
local dragInput, dragStart, startPos

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

TitleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

-- // ================= ОСНОВНАЯ ЛОГИКА =================

-- Сохраняем текущую позицию
local function saveCurrentPosition()
    local char = LocalPlayer.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    savedCFrame = hrp.CFrame
    return true
end

-- После респавна телепортируем обратно
local function onCharacterAdded(character)
    if not isImmortalActive then return end
    if not savedCFrame then return end

    local hrp = character:WaitForChild("HumanoidRootPart", 5)
    local humanoid = character:WaitForChild("Humanoid", 5)

    if not hrp or not humanoid then return end

    -- Небольшая задержка, чтобы сервер не перезаписал позицию
    task.wait(CONFIG.TeleportDelay)

    if hrp and hrp.Parent then
        hrp.CFrame = savedCFrame
    end
end

-- Включить/выключить бессмертие
local function toggleImmortal()
    isImmortalActive = not isImmortalActive

    if isImmortalActive then
        saveCurrentPosition()
        characterConn = LocalPlayer.CharacterAdded:Connect(onCharacterAdded)

        StatusDot.BackgroundColor3 = Color3.fromRGB(80, 255, 120)
        StatusLabel.Text = "Активно · ждём респавн"
        StatusLabel.TextColor3 = Color3.fromRGB(80, 255, 120)

        BtnText.Text = "♻️  Фейк-смерть [ВКЛ]"
        BtnText.TextColor3 = Color3.fromRGB(80, 255, 120)
        BtnStroke.Color = Color3.fromRGB(80, 255, 120)
        ImmortalBtn.BackgroundColor3 = Color3.fromRGB(30, 55, 40)

        BtnSubText.Text = "Повторное нажатие — выключить"
    else
        if characterConn then
            characterConn:Disconnect()
            characterConn = nil
        end

        savedCFrame = nil

        StatusDot.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
        StatusLabel.Text = "Выключено"
        StatusLabel.TextColor3 = Color3.fromRGB(150, 150, 160)

        BtnText.Text = "♻️  Фейк-смерть"
        BtnText.TextColor3 = Color3.fromRGB(200, 200, 210)
        BtnStroke.Color = Color3.fromRGB(80, 80, 100)
        ImmortalBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 50)

        BtnSubText.Text = "Нажми для активации · возврат после смерти"
    end
end

ImmortalBtn.MouseButton1Click:Connect(toggleImmortal)

