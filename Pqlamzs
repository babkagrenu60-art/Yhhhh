-- ============================================
local function findLastPlayer()
    local alive={}
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=LP then
            local c=plr.Character
            if c then
                local h=c:FindFirstChildOfClass("Humanoid")
                if h and h.Health>0 then
                    table.insert(alive,plr)
                end
            end
        end
    end
    if #alive==1 then return alive[1] end
    return nil
end

local function simulateClick()
    local vim=game:GetService("VirtualInputManager")
    if vim then
        pcall(function()
            vim:SendMouseButtonEvent(0,0,0,true,game,0)
            vim:SendMouseButtonEvent(0,0,0,false,game,0)
        end)
    end
end

local function autoFollowLoop()
    if followLoop then followLoop:Disconnect() end
    followLoop=RS.Heartbeat:Connect(function()
        if not autoFollow then return end
        local myHRP=getMyHRP()
        if not myHRP then return end
        local myHum=getMyChar() and getMyChar():FindFirstChildOfClass("Humanoid")
        if not myHum then return end

        -- проверяем: осталось 2 игрока (я + 1)
        local count=getPlayerCount()
        if count~=2 then return end

        local last=findLastPlayer()
        if not last then return end
        local tChar=last.Character
        if not tChar then return end
        local tHRP=tChar:FindFirstChild("HumanoidRootPart")
        if not tHRP then return end

        -- идём за ним
        local dist=(tHRP.Position-myHRP.Position).Magnitude
        if dist>5 then
            myHum:MoveTo(tHRP.Position)
        end

        -- автокликер
        local now=tick()
        if now-lastClick>clickDelay then
            lastClick=now
            simulateClick()
        end
    end)
end

