-- ============================================
local function getMyChar()
    return LP.Character
end

local function getMyHRP()
    local c=getMyChar()
    if not c then return nil end
    return c:FindFirstChild("HumanoidRootPart")
end

-- ищем инструмент с картошкой
local function findPotato()
    local c=getMyChar()
    if not c then return nil end
    for _,obj in ipairs(c:GetChildren()) do
        if obj:IsA("Tool") then
            local n=obj.Name:lower()
            if n:find("potato") or n:find("картош") or n:find("hot") then
                return obj
            end
        end
    end
    return nil
end

