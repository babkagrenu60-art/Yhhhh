local function getRandomPlayer()
    local list={}
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=LP and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            table.insert(list,plr)
        end
    end
    if #list==0 then return nil end
    return list[math.random(1,#list)]
end

local function getPlayerCount()
    local n=0
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr.Character and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health>0 then
            n=n+1
        end
    end
    return n
end

local function autoPassLoop()
    if passLoop then passLoop:Disconnect() end
    passLoop=RS.Heartbeat:Connect(function()
        if not autoPass then return end
        local myHRP=getMyHRP()
        if not myHRP then return end

        -- проверяем, есть ли картошка в руках
        local potato=findPotato()
        if not potato then return end

        -- запоминаем позицию ДО передачи
        local savedPos=myHRP.CFrame

        -- ищем случайного игрока
        local target=getRandomPlayer()
        if not target then return end
        local tChar=target.Character
        if not tChar then return end
        local tHRP=tChar:FindFirstChild("HumanoidRootPart")
        if not tHRP then return end

        -- телепорт к игроку
        myHRP.CFrame=CFrame.new(tHRP.Position+Vector3.new(0,3,0))

        -- пытаемся передать (активируем инструмент)
        task.wait(0.1)
        if potato and potato.Parent then
            pcall(function()
                potato:Activate()
            end)
            -- или через официальный способ передачи
            pcall(function()
                local remote=game:GetService("ReplicatedStorage"):FindFirstChild("PassPotato",true)
                if remote then
                    remote:FireServer(target)
                end
            end)
        end

        -- ждём подтверждения что передал (проверяем пропала ли картошка)
        task.wait(0.15)
        if not findPotato() then
            -- успешно передал! телепортируемся на сохранённую позицию + 45 блоков вверх
            myHRP.CFrame=savedPos+Vector3.new(0,45,0)
            StatusLbl.Text="Передал картошку · прыжок вверх"
            StatusLbl.TextColor3=Color3.fromRGB(255,180,120)
        end
    end)
end

