-- ФУНКЦИЯ 1: АФК ФАРМ
-- ============================================
local function startAfkFarm()
    if farmLoop then farmLoop:Disconnect() end
    farmLoop=RS.Heartbeat:Connect(function()
        if not afkFarm then return end
        local char=getMyChar()
        if not char then return end
        local hum=char:FindFirstChildOfClass("Humanoid")
        if hum then
            -- анти-кик от AFK
            hum:ChangeState(Enum.HumanoidStateType.Running)
            -- если есть Idled, отменяем
            if hum:GetAttribute("Idled") then
                hum:SetAttribute("Idled",false)
            end
        end
        -- имитируем движение чтобы Roblox не кикнул за АФК
        local vim=game:GetService("VirtualInputManager")
        if vim then
            pcall(function()
                vim:SendKeyEvent(true,Enum.KeyCode.W,false,game)
                task.wait(0.05)
                vim:SendKeyEvent(false,Enum.KeyCode.W,false,game)
            end)
        end
    end)
end

local function stopAfkFarm()
    if farmLoop then farmLoop:Disconnect();farmLoop=nil end
end

