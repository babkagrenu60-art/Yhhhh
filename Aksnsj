local settings={}
local settingsFile="MM2Settings"

local function loadSettings()
local success, data=pcall(function()
return HS:JSONDecode(HS:GetAsync(settingsFile))
end)
if success and data then
settings=data
print("✅ Настройки загружены")
else
settings={
flySpeed=30,
flyEnabled=false,
theme="dark",
particles=true,
rainbowMode=false,
autoUpdate=true,
notificationSound=true
}
saveSettings()
print("✅ Настройки по умолчанию созданы")
end
end

local function saveSettings()
local success, err=pcall(function()
HS:SetAsync(settingsFile, HS:JSONEncode(settings))
end)
if success then
print("✅ Настройки сохранены")
else
print("❌ Ошибка сохранения: "..tostring(err))
end
end

local function getSetting(key)
return settings[key]
end

local function setSetting(key, value)
settings[key]=value
saveSettings()
end

local function resetSettings()
settings={
flySpeed=30,
flyEnabled=false,
theme="dark",
particles=true,
rainbowMode=false,
autoUpdate=true,
notificationSound=true
}
