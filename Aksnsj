local function createParticleEffect(parent, color, size, amount)
local p=Instance.new("ParticleEmitter")
p.Parent=parent
p.Texture="rbxasset://textures/particles/sparkles_main.dds"
p.Color=color
p.Size=NumberSequence.new(size)
p.Lifetime=NumberRange.new(0.5,1)
p.Rate=amount
p.SpreadAngle=Vector2.new(360,360)
p.VelocityInheritance=0
p.Enabled=true
return p
end

local function createRainbowEffect(frame, speed)
local r=0
coroutine.wrap(function()
while frame and frame.Parent do
r=(r+speed)%1
local c=Color3.fromHSV(r,1,1)
frame.BackgroundColor3=c
wait(0.05)
end
end)()
end

local function pulseAnimation(frame, scale, duration)
local t=T:Create(frame,TweenInfo.new(duration,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{Size=UDim2.new(scale,0,scale,0)})
t:Play()
return t
end

local function shakeEffect(frame, intensity, duration)
local pos=frame.Position
local t=0
coroutine.wrap(function()
while t<duration do
local x=math.random(-intensity,intensity)
local y=math.random(-intensity,intensity)
frame.Position=UDim2.new(pos.X.Scale,pos.X.Offset+x,pos.Y.Scale,pos.Y.Offset+y)
wait(0.05)
t=t+0.05
end
frame.Position=pos
end)()
end

local function fadeIn(frame, duration)
local t=T:Create(frame,TweenInfo.new(duration,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{BackgroundTransparency=0})
t:Play()
return t
end

local function fadeOut(frame, duration)
local t=T:Create(frame,TweenInfo.new(duration,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{BackgroundTransparency=1})
t:Play()
return t
end

local function scaleUp(frame, scale, duration)
local t=T:Create(frame,TweenInfo.new(duration,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=UDim2.new(scale,0,scale,0)})
t:Play()
return t
end

local function colorTransition(frame, color1, color2, duration)
local t=T:Create(frame,TweenInfo.new(duration,Enum.EasingStyle.Linear,Enum.EasingDirection.InOut),{BackgroundColor3=color2})
t:Play()
return t
end

local function glowEffect(frame, intensity)
local g=Instance.new("UIGradient")
g.Parent=frame
g.Color=ColorSequence.new(Color3.fromRGB(255,255,255))
g.Rotation=45
local t=T:Create(g,TweenInfo.new(0.5,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{Transparency=NumberSequence.new(intensity)})
t:Play()
return g
end

