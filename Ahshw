end)

-- Ночное видение
nightVisionButton.MouseButton1Click:Connect(function()
    nightVisionEnabled = not nightVisionEnabled
    
    if nightVisionEnabled then
        nightVisionButton.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
        nightVisionButton.Text = "Ночное видение: ON"
        originalLightingSettings = enableNightVision()
    else
        nightVisionButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        nightVisionButton.Text = "Ночное видение: OFF"
        
        if originalLightingSettings then
            disableNightVision(originalLightingSettings)
            originalLightingSettings = nil
        end
    end
end)

-- Очистка при выходе
game:GetService("Players").PlayerRemoving:Connect(function(leavingPlayer)
    if leavingPlayer == player then
        clearESP()
        if nightVisionEnabled and originalLightingSettings then
            disableNightVision(originalLightingSettings)
        end
    end
end)
