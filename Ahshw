-- ==================== АИМБОТ ====================
local function findNearestTarget()
    local nearestTarget = nil
    local nearestDistance = math.huge
    
    for _, otherPlayer in pairs(game.Players:GetPlayers()) do
        if otherPlayer ~= player and otherPlayer.Character then
            local head = otherPlayer.Character:FindFirstChild("Head")
            local humanoid = otherPlayer.Character:FindFirstChild("Humanoid")
            
            if head and humanoid and humanoid.Health > 0 then
                local screenPos, onScreen = camera:WorldToScreenPoint(head.Position)
                
                if onScreen then
                    local distance = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)).Magnitude
                    
                    if distance < nearestDistance then
                        nearestDistance = distance
                        nearestTarget = head
                    end
                end
            end
        end
    end
    
    return nearestTarget
end

-- ==================== ESP ====================
local espHighlights = {}

local function clearESP()
    for _, highlight in pairs(espHighlights) do
        if highlight then
            highlight:Destroy()
        end
    end
    espHighlights = {}
end

local function createESP()
    clearESP()
    
    for _, otherPlayer in pairs(game.Players:GetPlayers()) do
        if otherPlayer ~= player and otherPlayer.Character then
            local highlight = Instance.new("Highlight")
            highlight.Parent = otherPlayer.Character
            highlight.FillColor = Color3.new(1, 0, 0)
            highlight.OutlineColor = Color3.new(1, 1, 1)
            highlight.FillTransparency = 0.5
            highlight.OutlineTransparency = 0
            highlight.Enabled = true
            
            table.insert(espHighlights, highlight)
            
            -- Обновление при возрождении
            otherPlayer.CharacterAdded:Connect(function(newCharacter)
                if espEnabled then
                    wait(0.5)
                    local newHighlight = Instance.new("Highlight")
                    newHighlight.Parent = newCharacter
                    newHighlight.FillColor = Color3.new(1, 0, 0)
                    newHighlight.OutlineColor = Color3.new(1, 1, 1)
                    newHighlight.FillTransparency = 0.5
                    newHighlight.OutlineTransparency = 0
                    newHighlight.Enabled = true
                    
                    table.insert(espHighlights, newHighlight)
                end
            end)
        end
    end
end

-- ==================== НОЧНОЕ ВИДЕНИЕ ====================
local function enableNightVision()
    local lighting = game:GetService("Lighting")
    
    -- Сохраняем оригинальные настройки
    local originalBrightness = lighting.Brightness
    local originalClockTime = lighting.ClockTime
    local originalAmbient = lighting.Ambient
    local originalOutdoorAmbient = lighting.OutdoorAmbient
    local originalFogColor = lighting.FogColor
    local originalFogEnd = lighting.FogEnd
    
    -- Включаем ночное видение
    lighting.Brightness = 2
    lighting.ClockTime = 14
    lighting.Ambient = Color3.fromRGB(150, 150, 150)
    lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 150)
    lighting.FogColor = Color3.fromRGB(100, 100, 100)
    lighting.FogEnd = 100000
    lighting.ExposureCompensation = 0.5
    
    return {
        originalBrightness = originalBrightness,
        originalClockTime = originalClockTime,
        originalAmbient = originalAmbient,
        originalOutdoorAmbient = originalOutdoorAmbient,
        originalFogColor = originalFogColor,
        originalFogEnd = originalFogEnd
    }
end

local function disableNightVision(originalSettings)
    local lighting = game:GetService("Lighting")
    
    lighting.Brightness = originalSettings.originalBrightness
    lighting.ClockTime = originalSettings.originalClockTime
    lighting.Ambient = originalSettings.originalAmbient
    lighting.OutdoorAmbient = originalSettings.originalOutdoorAmbient
    lighting.FogColor = originalSettings.originalFogColor
    lighting.FogEnd = originalSettings.originalFogEnd
    lighting.ExposureCompensation = 0
end

local originalLightingSettings = nil

