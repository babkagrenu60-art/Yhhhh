-- ============================================================
--  ФУНКЦИЯ ОБНОВЛЕНИЯ ПЕРСОНАЖА
-- ============================================================

local function UpdateCharacter()
    Character = Player.Character
    if Character then
        HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
        if HumanoidRootPart then
            return true
        end
    end
    return false
end

-- Ждём появления персонажа
local function WaitForCharacter()
    if not UpdateCharacter() then
        Player.CharacterAdded:Wait()
        UpdateCharacter()
    end
    return HumanoidRootPart ~= nil
end

-- ============================================================
--  ФУНКЦИЯ ПОЛЁТА
-- ============================================================

local function StartFly()
    if not WaitForCharacter() then
        FlyButton.Text = "🛫 Ошибка!"
        return
    end
    
    -- Считываем скорость
    local inputSpeed = tonumber(SpeedInput.Text)
    if inputSpeed and inputSpeed > 0 and inputSpeed <= 500 then
        speed = inputSpeed
    else
        speed = 50
        SpeedInput.Text = "50"
    end
    
    flying = true
    FlyButton.Text = "🛫 Fly: ВКЛ"
    FlyButton.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
    
    -- Создаём физику полёта
    bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.Parent = HumanoidRootPart
    
    bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bg.CFrame = HumanoidRootPart.CFrame
    bg.Parent = HumanoidRootPart
    
    local humanoid = Character:FindFirstChild("Humanoid")
    if humanoid then
        humanoid.PlatformStand = true
    end
end

local function StopFly()
    flying = false
    FlyButton.Text = "🛫 Fly: ВЫКЛ"
    FlyButton.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    
    if bv then bv:Destroy() bv = nil end
    if bg then bg:Destroy() bg = nil end
    
    local humanoid = Character and Character:FindFirstChild("Humanoid")
    if humanoid then
        humanoid.PlatformStand = false
    end
end

-- ============================================================
--  ОБНОВЛЕНИЕ ПЕРСОНАЖА ПРИ ВОЗРОЖДЕНИИ
-- ============================================================

Player.CharacterAdded:Connect(function(char)
    Character = char
    HumanoidRootPart = char:WaitForChild("HumanoidRootPart")
    if flying then
        -- Пересоздаём полёт при возрождении
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.PlatformStand = true
        end
        bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.Parent = HumanoidRootPart
        
        bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
        bg.CFrame = HumanoidRootPart.CFrame
        bg.Parent = HumanoidRootPart
    end
end)

-- ============================================================
--  ОБНОВЛЕНИЕ ПОЛЁТА КАЖДЫЙ КАДР
-- ============================================================

game:GetService("RunService").Heartbeat:Connect(function()
    if flying and HumanoidRootPart and Camera then
        if bv then
            bv.Velocity = Camera.CFrame.LookVector * speed
        end
        if bg then
            bg.CFrame = Camera.CFrame
        end
    end
end)

-- ============================================================
--  КНОПКИ
-- ============================================================

-- Открытие/закрытие меню
ToggleButton.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

-- Включение/выключение полёта
FlyButton.MouseButton1Click:Connect(function()
    if not HumanoidRootPart then
        if not WaitForCharacter() then
            FlyButton.Text = "🛫 Ошибка!"
            return
        end
    end
    
    if flying then
        StopFly()
    else
        StartFly()
    end
end)

-- ============================================================
--  ОЧИСТКА ПРИ ВЫХОДЕ (чтобы не оставалось BodyVelocity)
-- ============================================================

game.Players.LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("FlyGui").AncestryChanged:Connect(function()
    if not ScreenGui.Parent then
        StopFly()
    end
end)

