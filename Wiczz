-- Проверка стены (через FindPartOnRay — старый API, работает везде)
local function getWall()
    local char=LP.Character
    if not char then return nil end
    local hrp=char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local cam=workspace.CurrentCamera
    if not cam then return nil end

    local look=cam.CFrame.LookVector
    look=Vector3.new(look.X,0,look.Z)
    if look.Magnitude<0.01 then return nil end
    look=look.Unit

    local ray=Ray.new(hrp.Position,look*6)
    local hit,pos,normal=workspace:FindPartOnRay(ray,char)

    if hit then
        local horiz=Vector3.new(normal.X,0,normal.Z)
        if horiz.Magnitude>0.3 then
            return hit,look,normal
        end
    end
    return nil
end

-- Отскок
local function doWallClutch()
    local char=LP.Character
    if not char then return end
    local hrp=char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local hit,look=getWall()
    if not hit then
        StatusLbl.Text="Нет стены впереди"
        StatusLbl.TextColor3=Color3.fromRGB(255,120,120)
        return
    end

    local backward=-look
    local startPos=hrp.Position
    local targetPos=startPos + backward*Distance

    -- Проверка пола
    local rayDown=Ray.new(targetPos+Vector3.new(0,5,0),Vector3.new(0,-60,0))
    local floorHit,floorPos=workspace:FindPartOnRay(rayDown,char)
    if floorHit then
        targetPos=Vector3.new(targetPos.X,floorPos.Y+3.5,targetPos.Z)
    end

    -- Отключаем коллизию на миг
    local parts={}
    for _,p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            parts[p]=p.CanCollide
            p.CanCollide=false
        end
    end

    -- Плавный телепорт
    for i=1,6 do
        if not hrp.Parent then break end
        local a=i/6
        hrp.CFrame=CFrame.new(startPos:Lerp(targetPos,a))
        RS.RenderStepped:Wait()
    end

    task.wait(0.05)
    for p,val in pairs(parts) do
        if p and p.Parent then p.CanCollide=val end
    end

    StatusLbl.Text="Отскок · "..Distance.." блоков"
    StatusLbl.TextColor3=Color3.fromRGB(80,200,255)
end

