-- ESP
local espHighlights={}
local function getRole(targetPlayer)
    local character=targetPlayer.Character
    if not character then return"Innocent"end
    local backpack=targetPlayer:FindFirstChild("Backpack")
    if backpack then
        if backpack:FindFirstChild("Knife")then return"Murderer"
        elseif backpack:FindFirstChild("Gun")then return"Sheriff"end
    end
    return"Innocent"
end
local function clearESP()
    for _,h in pairs(espHighlights)do
        if h and h.Parent then h:Destroy()end
    end
    espHighlights={}
end
local function addESP(targetPlayer)
    if targetPlayer.Character then
        local role=getRole(targetPlayer)
        local h=Instance.new("Highlight")
        h.Parent=targetPlayer.Character
        if role=="Murderer"then
            h.FillColor=Color3.fromRGB(255,0,0)
        elseif role=="Sheriff"then
            h.FillColor=Color3.fromRGB(0,0,255)
        else
            h.FillColor=Color3.fromRGB(0,255,0)
        end
        h.FillTransparency=0.4
        table.insert(espHighlights,h)
    end
end
local function createESP()
    clearESP()
    for _,otherPlayer in pairs(game.Players:GetPlayers())do
        if otherPlayer~=player then
            addESP(otherPlayer)
            otherPlayer.CharacterAdded:Connect(function()
                if espEnabled then wait(0.5)addESP(otherPlayer)end
            end)
        end
    end
end

espBtn.Activated:Connect(function()
    espEnabled=not espEnabled
    if espEnabled then
        espBtn.BackgroundColor3=Color3.fromRGB(255,0,0)
        espBtn.Text="ESP: ON"
        createESP()
    else
        espBtn.BackgroundColor3=Color3.fromRGB(0,170,0)
        espBtn.Text="ESP: OFF"
        clearESP()
    end
end)

game:GetService("RunService").Heartbeat:Connect(function()
