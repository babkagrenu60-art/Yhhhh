-- ESP
local folder = Instance.new("Folder")
folder.Name = "ESP"
folder.Parent = gui

local function clearESP()
	for _, v in pairs(folder:GetChildren()) do
		v:Destroy()
	end
end

local function makeESP(plr)
	if plr == LP then return end
	local char = plr.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or not root then return end

	local bb = Instance.new("BillboardGui")
	bb.Name = plr.Name
	bb.Adornee = root
	bb.Size = UDim2.new(0, 130, 0, 42)
	bb.StudsOffset = Vector3.new(0, 3.1, 0)
	bb.AlwaysOnTop = true
	bb.Parent = folder

	local fr = Instance.new("Frame")
	fr.Size = UDim2.new(1, 0, 1, 0)
	fr.BackgroundColor3 = Color3.fromRGB(18, 18, 26)
	fr.BackgroundTransparency = 0.3
	fr.BorderSizePixel = 0
	fr.Parent = bb
	Instance.new("UICorner", fr).CornerRadius = UDim.new(0, 6)

	local nameL = Instance.new("TextLabel")
	nameL.Size = UDim2.new(1, -4, 0, 16)
	nameL.Position = UDim2.new(0, 2, 0, 2)
	nameL.BackgroundTransparency = 1
	nameL.Text = plr.Name
	nameL.Font = Enum.Font.GothamBold
	nameL.TextSize = 12
	nameL.TextColor3 = Color3.new(1, 1, 1)
	nameL.Parent = fr

	local info = Instance.new("TextLabel")
	info.Size = UDim2.new(1, -4, 0, 14)
	info.Position = UDim2.new(0, 2, 0, 18)
	info.BackgroundTransparency = 1
	info.Font = Enum.Font.Gotham
	info.TextSize = 11
	info.TextColor3 = Color3.fromRGB(170, 210, 255)
	info.Parent = fr

	local conn
	conn = RS.RenderStepped:Connect(function()
		if not char.Parent or not root.Parent or hum.Health <= 0 then
			bb:Destroy()
			conn:Disconnect()
			return
		end
		local d = (root.Position - Camera.CFrame.Position).Magnitude
		bb.Enabled = d <= Settings.ESP.MaxDist
		info.Text = math.floor(d) .. "m  HP:" .. math.floor(hum.Health)
	end)
end

-- Wall Check
local function isVisible(part)
	local origin = Camera.CFrame.Position
	local direction = part.Position - origin
	local result = workspace:Raycast(origin, direction)
	if not result then return true end
	return result.Instance:IsDescendantOf(part.Parent)
end

-- Aimbot
local function getTarget()
	local closest = nil
	local shortest = Settings.Aimbot.FOV

	for _, p in pairs(Players:GetPlayers()) do
		if p == LP then continue end
		if Settings.Aimbot.TeamCheck and p.Team == LP.Team then continue end

		local char = p.Character
		if not char then continue end

		local hum = char:FindFirstChildOfClass("Humanoid")
		local part = char:FindFirstChild(Settings.Aimbot.AimPart) or char:FindFirstChild("HumanoidRootPart")
		if not hum or not part or hum.Health <= 0 then continue end

		if Settings.Aimbot.WallCheck and not isVisible(part) then continue end

		local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
		if not onScreen then continue end

		local dist = (Vector2.new(pos.X, pos.Y) - Camera.ViewportSize / 2).Magnitude
		if dist < shortest then
			shortest = dist
			closest = part
		end
	end
	return closest
end

-- Главный цикл
RS.RenderStepped:Connect(function()
	-- ESP
	if Settings.ESP.Enabled then
		for _, p in pairs(Players:GetPlayers()) do
			if p \~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				if not folder:FindFirstChild(p.Name) then
					makeESP(p)
				end
			end
		end
	else
		clearESP()
	end

	-- Aimbot
	if Settings.Aimbot.Enabled then
		local target = getTarget()
		if target then
			Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, target.Position), Settings.Aimbot.Smooth)
		end
	end
end)

