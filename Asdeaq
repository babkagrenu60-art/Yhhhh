-- ============================================================
--  ОБНОВЛЕНИЕ ПЕРСОНАЖА
-- ============================================================

local function UpdateCharacter()
    Character = Player.Character
    if Character then
        HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
        if HumanoidRootPart then
            return true
        end
    end
    return false
end

local function WaitForCharacter()
    if not UpdateCharacter() then
        Player.CharacterAdded:Wait()
        UpdateCharacter()
    end
    return HumanoidRootPart ~= nil
end

-- ============================================================
--  УПРАВЛЕНИЕ ЧЕРЕЗ ДЖОЙСТИК (WASD + СТИК)
-- ============================================================

-- Обработка нажатий клавиш (WASD)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if not flying then return end
    
    if input.KeyCode == Enum.KeyCode.W then
        moveDirection = moveDirection + Vector3.new(0, 0, -1)
        isMoving = true
    elseif input.KeyCode == Enum.KeyCode.S then
        moveDirection = moveDirection + Vector3.new(0, 0, 1)
        isMoving = true
    elseif input.KeyCode == Enum.KeyCode.A then
        moveDirection = moveDirection + Vector3.new(-1, 0, 0)
        isMoving = true
    elseif input.KeyCode == Enum.KeyCode.D then
        moveDirection = moveDirection + Vector3.new(1, 0, 0)
        isMoving = true
    elseif input.KeyCode == Enum.KeyCode.Space then
        -- Вверх (пробел)
        moveDirection = moveDirection + Vector3.new(0, 1, 0)
        isMoving = true
    elseif input.KeyCode == Enum.KeyCode.LeftShift then
        -- Вниз (Shift)
        moveDirection = moveDirection + Vector3.new(0, -1, 0)
        isMoving = true
    end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if not flying then return end
    
    if input.KeyCode == Enum.KeyCode.W then
        moveDirection = moveDirection - Vector3.new(0, 0, -1)
    elseif input.KeyCode == Enum.KeyCode.S then
        moveDirection = moveDirection - Vector3.new(0, 0, 1)
    elseif input.KeyCode == Enum.KeyCode.A then
        moveDirection = moveDirection - Vector3.new(-1, 0, 0)
    elseif input.KeyCode == Enum.KeyCode.D then
        moveDirection = moveDirection - Vector3.new(1, 0, 0)
    elseif input.KeyCode == Enum.KeyCode.Space then
        moveDirection = moveDirection - Vector3.new(0, 1, 0)
    elseif input.KeyCode == Enum.KeyCode.LeftShift then
        moveDirection = moveDirection - Vector3.new(0, -1, 0)
    end
    
    -- Если все клавиши отпущены — останавливаемся
    if moveDirection.Magnitude < 0.1 then
        isMoving = false
    end
end)

-- ============================================================
--  ФУНКЦИЯ ПОЛЁТА
-- ============================================================

local function StartFly()
    if not WaitForCharacter() then
        FlyButton.Text = "🛫 Ошибка!"
        return
    end
    
    local inputSpeed = tonumber(SpeedInput.Text)
    if inputSpeed and inputSpeed > 0 and inputSpeed <= 500 then
        speed = inputSpeed
    else
        speed = 30
        SpeedInput.Text = "30"
    end
    
    flying = true
    FlyButton.Text = "🛫 Fly: ВКЛ"
    FlyButton.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
    
    bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.Parent = HumanoidRootPart
    
    bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bg.CFrame = HumanoidRootPart.CFrame
    bg.Parent = HumanoidRootPart
    
    local humanoid = Character:FindFirstChild("Humanoid")
    if humanoid then
        humanoid.PlatformStand = true
    end
    
    -- Сброс направления
    moveDirection = Vector3.new(0, 0, 0)
    isMoving = false
end

local function StopFly()
    flying = false
    FlyButton.Text = "🛫 Fly: ВЫКЛ"
    FlyButton.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    
    if bv then bv:Destroy() bv = nil end
    if bg then bg:Destroy() bg = nil end
    
    local humanoid = Character and Character:FindFirstChild("Humanoid")
    if humanoid then
        humanoid.PlatformStand = false
    end
    
    moveDirection = Vector3.new(0, 0, 0)
    isMoving = false
end

-- ============================================================
--  ОБНОВЛЕНИЕ ПОЛЁТА КАЖДЫЙ КАДР (С УЧЁТОМ НАПРАВЛЕНИЯ)
-- ============================================================

RunService.Heartbeat:Connect(function()
    if flying and HumanoidRootPart and Camera then
        if bv then
            -- Если двигаемся — летим в направлении джойстика
            if isMoving or moveDirection.Magnitude > 0.1 then
                -- Преобразуем направление относительно камеры
                local camForward = Camera.CFrame.LookVector
                local camRight = Camera.CFrame.RightVector
                local camUp = Camera.CFrame.UpVector
                
                local moveVec = (camForward * moveDirection.Z * -1) + (camRight * moveDirection.X) + (camUp * moveDirection.Y)
                
                if moveVec.Magnitude > 0.1 then
                    bv.Velocity = moveVec.Unit * speed
                else
                    bv.Velocity = Vector3.new(0, 0, 0)
                end
            else
                -- Если ничего не нажато — зависаем на месте
                bv.Velocity = Vector3.new(0, 0, 0)
            end
        end
        if bg then
            bg.CFrame = Camera.CFrame
        end
    end
end)

-- ============================================================
--  ПЕРЕСОЗДАНИЕ ПОЛЁТА ПРИ ВОЗРОЖДЕНИИ
-- ============================================================

Player.CharacterAdded:Connect(function(char)
    Character = char
    HumanoidRootPart = char:WaitForChild("HumanoidRootPart")
    if flying then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.PlatformStand = true
        end
        bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.Parent = HumanoidRootPart
        
        bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
        bg.CFrame = HumanoidRootPart.CFrame
        bg.Parent = HumanoidRootPart
    end
end)

-- ============================================================
--  КНОПКИ
-- ============================================================

ToggleButton.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

FlyButton.MouseButton1Click:Connect(function()
    if not HumanoidRootPart then
        if not WaitForCharacter() then
            FlyButton.Text = "🛫 Ошибка!"
            return
        end
    end
    
    if flying then
        StopFly()
    else
        StartFly()
    end
end)

