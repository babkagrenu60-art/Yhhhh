-- Авто подбор пистолета
local autoPickupBtn = createToggle(section1, "🔫 Авто подбор пистолета", yPos, nil, false)
yPos = yPos + 45
autoPickupBtn.OnClick = function(state)
    if state then
        originalPosition = rootPart.CFrame
        spawn(function()
            while autoPickupBtn.BackgroundColor3 == Color3.fromRGB(0, 200, 0) do
                RunService.RenderStepped:Wait()
                local pistolModel = workspace:FindFirstChild("Pistol")
                if pistolModel and pistolModel:IsA("Model") then
                    local pistolPart = pistolModel:FindFirstChild("Handle") or pistolModel:FindFirstChild("MainPart")
                    if pistolPart then
                        rootPart.CFrame = pistolPart.CFrame * CFrame.new(0, 2, 2)
                        task.wait(0.3)
                        rootPart.CFrame = originalPosition
                    end
                end
                task.wait(0.5)
            end
        end)
    end
end

-- Авто уклонение
local dodgeBtn = createToggle(section1, "🛡️ Авто-уклонение (Манс)", yPos, nil, false)
yPos = yPos + 45
dodgeBtn.OnClick = function(state)
    isDodging = state
    if state then
        spawn(function()
            while isDodging do
                RunService.RenderStepped:Wait()
                -- Проверяем наличие ножа рядом
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("Tool") and obj.Name:find("Knife") then
                        local knifePos = obj:FindFirstChild("Handle")
                        if knifePos then
                            local distance = (rootPart.Position - knifePos.Position).Magnitude
                            if distance < 8 then
                                if dodgeMode == "teleport" then
                                    local randomDir = Vector3.new(
                                        math.random(-10, 10),
                                        0,
                                        math.random(-10, 10)
                                    )
                                    rootPart.CFrame = rootPart.CFrame + CFrame.new(randomDir) * CFrame.new(0, 0, 5)
                                    task.wait(0.1)
                                    rootPart.CFrame = rootPart.CFrame * CFrame.new(0, 0, -5)
                                else
                                    humanoid.Jump = true
                                    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                                end
                                break
                            end
                        end
                    end
                end
            end
        end)
    end
end

