-- Авто выстрел
local autoShootBtn = createToggle(section2, "🎯 Авто-выстрел в убийцу", yPos, nil, false)
yPos = yPos + 45
autoShootBtn.OnClick = function(state)
    autoShootActive = state
    if state then
        spawn(function()
            while autoShootActive do
                RunService.RenderStepped:Wait()
                local pistolModel = workspace:FindFirstChild("Pistol")
                if pistolModel then
                    for _, playerObj in pairs(Players:GetPlayers()) do
                        if playerObj ~= player then
                            local char = playerObj.Character
                            if char then
                                local head = char:FindFirstChild("Head")
                                local root = char:FindFirstChild("HumanoidRootPart")
                                if head and root then
                                    local distance = (rootPart.Position - root.Position).Magnitude
                                    if distance < 50 then
                                        -- Имитация выстрела
                                        local ray = Ray.new(
                                            rootPart.Position,
                                            (head.Position - rootPart.Position).Unit * 100
                                        )
                                        local hit = workspace:FindPartOnRay(ray, character)
                                        if hit and hit:IsDescendantOf(char) then
                                            -- Наносим урон (только на копии!)
                                            if char:FindFirstChild("Humanoid") then
                                                char.Humanoid.Health = char.Humanoid.Health - 20
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
                task.wait(0.3)
            end
        end)
    end
end

-- Стрельба при ноже
local knifeShootBtn = createToggle(section2, "🔪 Стрелять, когда убийца достал нож", yPos, nil, false)
yPos = yPos + 45
knifeShootBtn.OnClick = function(state)
    shootOnKnife = state
    if state then
        spawn(function()
            while shootOnKnife do
                RunService.RenderStepped:Wait()
                for _, knife in pairs(workspace:GetDescendants()) do
                    if knife:IsA("Tool") and knife.Name:find("Knife") then
                        local owner = knife.Parent
                        if owner and owner:FindFirstChild("Humanoid") then
                            local ownerPlayer = Players:GetPlayerFromCharacter(owner)
                            if ownerPlayer and ownerPlayer ~= player then
                                -- Стреляем в убийцу
                                local head = owner:FindFirstChild("Head")
                                if head then
                                    -- Имитация выстрела
                                    local ray = Ray.new(
                                        rootPart.Position,
                                        (head.Position - rootPart.Position).Unit * 100
                                    )
                                    local hit = workspace:FindPartOnRay(ray, character)
                                    if hit and hit:IsDescendantOf(owner) then
                                        owner.Humanoid.Health = owner.Humanoid.Health - 25
                                    end
                                end
                            end
                        end
                    end
                end
                task.wait(0.5)
            end
        end)
    end
end

