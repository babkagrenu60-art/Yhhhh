-- СОЗДАНИЕ КАКАШКИ
local function makePoo()
    local char=LP.Character
    if not char then return end
    local hrp=char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local poo=Instance.new("Part")
    poo.Name="Poo"
    poo.Size=Vector3.new(1.5,0.6,1.5)
    poo.Shape=Enum.PartType.Ball
    poo.Color=Color3.fromRGB(120,80,40)
    poo.Material=Enum.Material.SmoothPlastic
    poo.Anchored=true
    poo.CanCollide=false
    poo.CFrame=CFrame.new(hrp.Position-Vector3.new(0,2.5,0))
    poo.Parent=workspace

    -- Запах (частицы)
    local att=Instance.new("Attachment");att.Parent=poo
    local emit=Instance.new("ParticleEmitter")
    emit.Texture="rbxassetid://243660364"
    emit.Rate=8;emit.Lifetime=NumberRange.new(1,2)
    emit.Speed=NumberRange.new(1,3);emit.Size=NumberSequence.new(0.8)
    emit.Color=ColorSequence.new(Color3.fromRGB(120,80,40))
    emit.Transparency=NumberSequence.new(0.5)
    emit.Parent=att

    table.insert(poops,poo)

    -- Реакция на наступание
    poo.Touched:Connect(function(hit)
        if not active then return end
        local h=hit.Parent
        if not h then return end
        local hum=h:FindFirstChildOfClass("Humanoid")
        local hrp2=h:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp2 then return end
        -- Откидываем наступившего
        local dir=Vector3.new(math.random(-1,1),0,math.random(-1,1))
        if dir.Magnitude<0.1 then dir=Vector3.new(1,0,0) end
        dir=dir.Unit
        hrp2.AssemblyLinearVelocity=dir*250+Vector3.new(0,180,0)
        hum.PlatformStand=true
        task.delay(0.5,function() if hum and hum.Parent then hum.PlatformStand=false end end)
        -- Крик
        local snd=Instance.new("Sound")
        snd.SoundId=SCREAM;snd.Volume=4
        snd.Parent=hrp2;snd:Play()
        task.delay(2,function() if snd then snd:Destroy() end end)
        -- Какашка исчезает
        poo:Destroy()
    end)

    SL.Text="💩 Накакал! Всего: "..#poops
    SL.TextColor3=Color3.fromRGB(180,120,60)
    task.delay(2,function()
        if not active then
            SL.Text="Реакция выключена"
            SL.TextColor3=Color3.fromRGB(150,130,100)
        end
    end)
end

PooBtn.MouseButton1Click:Connect(function()
