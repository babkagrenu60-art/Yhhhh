local function getAvatar(n)
	local ok,id=P:GetUserIdFromNameAsync(n)
	if ok and id then
		local img=P:GetUserThumbnailAsync(id,Enum.ThumbnailType.HeadShot,Enum.ThumbnailSize.Size150x150)
		avatar.Image=img
		return true
	end
	return false
end

name.FocusLost:Connect(function()
	if name.Text~="" then
		pcall(function()getAvatar(name.Text)end)
	end
end)

