-- ==================== ФУНКЦИЯ ПОЛУЧЕНИЯ РОЛИ ====================
local function getPlayerRole(targetPlayer)
    -- Проверяем через различные методы
    local character = targetPlayer.Character
    
    if not character then
        return "Unknown"
    end
    
    -- Метод 1: Проверка через Backpack
    local backpack = targetPlayer:FindFirstChild("Backpack")
    if backpack then
        if backpack:FindFirstChild("Knife") then
            return "Murderer"
        elseif backpack:FindFirstChild("Gun") then
            return "Sheriff"
        end
    end
    
    -- Метод 2: Проверка через Character
    if character:FindFirstChild("Knife") then
        return "Murderer"
    elseif character:FindFirstChild("Gun") then
        return "Sheriff"
    end
    
    -- Метод 3: Проверка через лидера (leaderstats)
    local leaderstats = targetPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in pairs(leaderstats:GetChildren()) do
            if stat.Name == "Role" or stat.Name == "role" then
                if stat.Value == "Murderer" or stat.Value == "Маньяк" then
                    return "Murderer"
                elseif stat.Value == "Sheriff" or stat.Value == "Шериф" then
                    return "Sheriff"
                elseif stat.Value == "Innocent" or stat.Value == "Невинный" then
                    return "Innocent"
                end
            end
        end
    end
    
    -- Метод 4: Проверка через PlayerGui
    local playerGui = targetPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        if playerGui:FindFirstChild("MurdererGUI") or playerGui:FindFirstChild("MurdererGui") then
            return "Murderer"
        elseif playerGui:FindFirstChild("SheriffGUI") or playerGui:FindFirstChild("SheriffGui") then
            return "Sheriff"
        end
    end
    
    -- По умолчанию - невинный
    return "Innocent"
end

-- ==================== ESP ====================
local espHighlights = {}

local function clearESP()
    for _, highlight in pairs(espHighlights) do
        if highlight and highlight.Parent then
            highlight:Destroy()
        end
    end
    espHighlights = {}
end

local function addESPToPlayer(targetPlayer)
    if targetPlayer.Character then
        local role = getPlayerRole(targetPlayer)
        local highlight = Instance.new("Highlight")
        highlight.Name = "ESPHighlight"
        highlight.Parent = targetPlayer.Character
        
        if role == "Murderer" then
            highlight.FillColor = Color3.fromRGB(255, 0, 0) -- Красный
            highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
        elseif role == "Sheriff" then
            highlight.FillColor = Color3.fromRGB(0, 0, 255) -- Синий
            highlight.OutlineColor = Color3.fromRGB(0, 0, 255)
        else -- Innocent
            highlight.FillColor = Color3.fromRGB(0, 255, 0) -- Зелёный
            highlight.OutlineColor = Color3.fromRGB(0, 255, 0)
        end
        
        highlight.FillTransparency = 0.4
        highlight.OutlineTransparency = 0
        table.insert(espHighlights, highlight)
    end
end

local function createESP()
    clearESP()
    
    for _, otherPlayer in pairs(game.Players:GetPlayers()) do
        if otherPlayer ~= player then
            addESPToPlayer(otherPlayer)
            
            otherPlayer.CharacterAdded:Connect(function()
                if espEnabled then
                    wait(0.5)
                    addESPToPlayer(otherPlayer)
                end
            end)
        end
    end
end

-- ==================== АИМБОТ ====================
local aimbotConnection = nil

local function getAimPart(character)
    if aimPart == "Head" then
        return character:FindFirstChild("Head")
    elseif aimPart == "HumanoidRootPart" then
        return character:FindFirstChild("HumanoidRootPart")
    elseif aimPart == "LeftLeg" then
        return character:FindFirstChild("LeftLeg") or character:FindFirstChild("Left Leg")
    elseif aimPart == "RightLeg" then
        return character:FindFirstChild("RightLeg") or character:FindFirstChild("Right Leg")
    end
    return character:FindFirstChild("Head")
end

local function startAimbot()
    aimbotConnection = game:GetService("RunService").RenderStepped:Connect(function()
        if aimbotEnabled then
            local nearestTarget = nil
            local nearestDistance = 500
            
            for _, otherPlayer in pairs(game.Players:GetPlayers()) do
                if otherPlayer ~= player and otherPlayer.Character then
                    local targetPart = getAimPart(otherPlayer.Character)
                    local humanoid = otherPlayer.Character:FindFirstChild("Humanoid")
                    
                    if targetPart and humanoid and humanoid.Health > 0 then
                        local screenPos, onScreen = camera:WorldToScreenPoint(targetPart.Position)
                        
                        if onScreen then
                            local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
                            local distance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                            
                            if distance < nearestDistance then
                                nearestDistance = distance
                                nearestTarget = targetPart
                            end
                        end
                    end
                end
            end
            
            if nearestTarget then
                camera.CFrame = CFrame.new(camera.CFrame.Position, nearestTarget.Position)
            end
        end
    end)
end

