local function UC()
char=P.Character
if char then
hrp=char:FindFirstChild("HumanoidRootPart")
if hrp then
return true
end
end
return false
end
local function WFC()
if not UC() then
P.CharacterAdded:Wait()
UC()
end
return hrp~=nil
end
U.InputBegan:Connect(function(i)
if not fly then return end
local k=i.KeyCode
if k==Enum.KeyCode.W then
dir=dir+Vector3.new(0,0,-1)
elseif k==Enum.KeyCode.S then
dir=dir+Vector3.new(0,0,1)
elseif k==Enum.KeyCode.A then
dir=dir+Vector3.new(-1,0,0)
elseif k==Enum.KeyCode.D then
dir=dir+Vector3.new(1,0,0)
elseif k==Enum.KeyCode.Space then
dir=dir+Vector3.new(0,1,0)
elseif k==Enum.KeyCode.LeftShift then
dir=dir+Vector3.new(0,-1,0)
end
end)
U.InputEnded:Connect(function(i)
if not fly then return end
local k=i.KeyCode
if k==Enum.KeyCode.W then
dir=dir-Vector3.new(0,0,-1)
elseif k==Enum.KeyCode.S then
dir=dir-Vector3.new(0,0,1)
elseif k==Enum.KeyCode.A then
dir=dir-Vector3.new(-1,0,0)
elseif k==Enum.KeyCode.D then
dir=dir-Vector3.new(1,0,0)
elseif k==Enum.KeyCode.Space then
dir=dir-Vector3.new(0,1,0)
elseif k==Enum.KeyCode.LeftShift then
dir=dir-Vector3.new(0,-1,0)
end
end)
