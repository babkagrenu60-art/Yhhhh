if fly and hrp and C then
if bv then
local mv=Vector3.new(0,0,0)
local cf=C.CFrame.LookVector
local cr=C.CFrame.RightVector
local cu=C.CFrame.UpVector
mv=(cf*-dir.Z)+(cr*dir.X)+(cu*dir.Y)
if mv.Magnitude>0.1 then
bv.Velocity=mv.Unit*sp
else
bv.Velocity=Vector3.new(0,0,0)
end
end
if bg then
bg.CFrame=C.CFrame
end
end
end)
