-- Функция для определения роли игрока
local function getPlayerRole(player)
    if player == LocalPlayer then return "Вы" end
    
    local char = player.Character
    local backpack = player.Backpack
    
    if not char then return "Неизвестно" end
    
    -- Проверяем наличие оружия в руках или в рюкзаке
    local hasKnife = char:FindFirstChild("Knife") or backpack:FindFirstChild("Knife")
    local hasGun = char:FindFirstChild("Gun") or backpack:FindFirstChild("Gun")
    
    if hasKnife and hasGun then
        return "Убийца/Шериф"
    elseif hasKnife then
        return "Убийца"
    elseif hasGun then
        return "Шериф"
    else
        return "Невиновный"
    end
end

-- Функция для создания ESP
local function createESP(player)
    if player == LocalPlayer then return end
    
    local char = player.Character
    if not char then return end
    
    -- Удаляем старый ESP
    if char:FindFirstChild("RoleESP") then
        char.RoleESP:Destroy()
    end
    
    local role = getPlayerRole(player)
    local color
    
    if role == "Убийца" then
        color = Color3.fromRGB(255, 0, 0)
    elseif role == "Шериф" then
        color = Color3.fromRGB(0, 0, 255)
    else
        color = Color3.fromRGB(0, 255, 0)
    end
    
    local box = Instance.new("BoxHandleAdornment")
    box.Name = "RoleESP"
    box.Size = Vector3.new(4, 6, 4)
    box.Color3 = color
    box.AlwaysOnTop = true
    box.ZIndex = 5
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        box.Adornee = hrp
        box.Parent = char
    end
end

-- Обновление ESP
local function updateESP()
    for _, player in pairs(Players:GetPlayers()) do
        createESP(player)
    end
end

-- Подписка на события
Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        createESP(player)
    end)
end)

Players.PlayerRemoving:Connect(function()
    task.wait(0.1)
    updateESP()
end)

-- Запуск ESP
task.spawn(function()
    while task.wait(1) do
        updateESP()
    end
end)

