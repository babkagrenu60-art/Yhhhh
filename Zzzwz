local function createBox(plr)
    local box=Instance.new("Frame")
    box.Name="ESP_"..plr.Name
    box.BackgroundTransparency=1
    box.BorderSizePixel=0
    box.Visible=false
    box.ZIndex=10
    box.Parent=SG

    local s=Instance.new("UIStroke")
    s.Color=Color3.fromRGB(0,255,80)
    s.Thickness=2.5
    s.Parent=box

    -- СТАТУС (главная надпись над рамкой)
    local status=Instance.new("TextLabel")
    status.Size=UDim2.new(1,0,0,18)
    status.Position=UDim2.new(0,0,-22,0)
    status.BackgroundTransparency=1
    status.Text="🙂 Новичок"
    status.TextColor3=Color3.fromRGB(0,255,80)
    status.TextSize=13
    status.Font=Enum.Font.GothamBold
    status.TextStrokeTransparency=0
    status.TextStrokeColor3=Color3.fromRGB(0,0,0)
    status.Parent=box

    -- ИМЯ (мелкое, под статусом)
    local name=Instance.new("TextLabel")
    name.Size=UDim2.new(1,0,0,12)
    name.Position=UDim2.new(0,0,-40,0)
    name.BackgroundTransparency=1
    name.Text=plr.Name
    name.TextColor3=Color3.fromRGB(200,200,200)
    name.TextSize=10
    name.Font=Enum.Font.Gotham
    name.TextStrokeTransparency=0
    name.TextStrokeColor3=Color3.fromRGB(0,0,0)
    name.Parent=box

    return {frame=box,name=name,status=status,plr=plr}
end

local function removeBox(plr)
    if espBoxes[plr] then espBoxes[plr].frame:Destroy();espBoxes[plr]=nil end
end

local function updateBoxes()
    if not espEnabled then return end
    local cam=workspace.CurrentCamera
    if not cam then return end

    for _,plr in ipairs(P:GetPlayers()) do
        if plr~=LP then
            if not espBoxes[plr] then espBoxes[plr]=createBox(plr) end
            local ref=espBoxes[plr]
            local char=plr.Character
            if char then
                local hrp=char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local _,onScreen=cam:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local head=char:FindFirstChild("Head")
                        local topY=hrp.Position.Y+3
                        local bottomY=hrp.Position.Y-3
                        if head then topY=head.Position.Y+0.5 end
                        if char:FindFirstChild("Humanoid") then
                            bottomY=hrp.Position.Y-(char.Humanoid.HipHeight or 2)+0.5
                        end
                        local topScreen=cam:WorldToViewportPoint(Vector3.new(hrp.Position.X,topY,hrp.Position.Z))
                        local bottomScreen=cam:WorldToViewportPoint(Vector3.new(hrp.Position.X,bottomY,hrp.Position.Z))
                        local height=math.abs(topScreen.Y-bottomScreen.Y)
                        local width=height*0.6
                        ref.frame.Size=UDim2.new(0,width,0,height)
                        ref.frame.Position=UDim2.new(0,topScreen.X-width/2,0,topScreen.Y)
                        ref.frame.Visible=true

                        -- ОБНОВЛЯЕМ СТАТУС
                        local s=stats[plr]
                        local stName,stColor=getStatus(s)
                        ref.status.Text=stName
                        ref.status.TextColor3=stColor
                        ref.name.Text=plr.Name

                        -- Цвет рамки под статус
                        local st=ref.frame:FindFirstChildOfClass("UIStroke")
                        if st then st.Color=stColor end
                    else
                        ref.frame.Visible=false
                    end
                else
                    ref.frame.Visible=false
                end
            else
                ref.frame.Visible=false
            end
        end
    end

    for plr,_ in pairs(espBoxes) do
        if not plr.Parent then removeBox(plr) end
    end
end

-- ===== АНАЛИЗ =====
local function runAnalysis()
    analyzing=true;progress=0
    ProgressFrame.Visible=true;ToggleBtn.Visible=false
    local messages={
        "Сканирую игроков...",
        "Анализ активности...",
        "Подсчёт прыжков...",
        "Измерение пути...",
        "Определение статусов...",
        "Загрузка ESP...",
    }
    local totalTime=5
    local startTick=tick()
    task.spawn(function()
        while analyzing do
            local elapsed=tick()-startTick
            progress=math.min(100,(elapsed/totalTime)*100)
            ProgressFill.Size=UDim2.new(progress/100,0,1,0)
            local msgIdx=math.min(#messages,math.floor((progress/100)*#messages)+1)
            ProgressLbl.Text=messages[msgIdx].." "..math.floor(progress).."%"
            if progress>=100 then analyzing=false;break end
            task.wait(0.05)
        end
        task.wait(0.3)
        ProgressLbl.Text="✅ Готово! 100%"
        task.wait(0.6)
        ProgressFrame.Visible=false
        ToggleBtn.Visible=true
        espEnabled=true
        ToggleBtn.Text="🎯  ВЫКЛЮЧИТЬ ESP"
        ToggleBtn.BackgroundColor3=Color3.fromRGB(55,35,35)
        ToggleBtn.TextColor3=Color3.fromRGB(255,150,150)
        Info.Text="ESP активно · статусы над игроками"
        Info.TextColor3=Color3.fromRGB(150,255,180)
    end)
end

local function stopESP()
    espEnabled=false;analyzing=false
    ProgressFrame.Visible=false;ToggleBtn.Visible=true
    ToggleBtn.Text="🎯  ВКЛЮЧИТЬ ESP"
    ToggleBtn.BackgroundColor3=Color3.fromRGB(35,55,40)
    ToggleBtn.TextColor3=Color3.fromRGB(150,255,180)
    Info.Text="Рамки + статус над игроком"
    Info.TextColor3=Color3.fromRGB(150,150,170)
    for _,ref in pairs(espBoxes) do ref.frame.Visible=false end
end

ToggleBtn.MouseButton1Click:Connect(function()
    if analyzing then return end
    if espEnabled then stopESP() else runAnalysis() end
end)

