-- ===== ТРЕКИНГ АКТИВНОСТИ =====
local function init(plr)
    if stats[plr] then return end
    stats[plr]={jumps=0,walked=0,afkTime=0,lastPos=nil,maxSpeed=0,lastMoveTime=tick()}
    local function bindJump(char)
        local hum=char:WaitForChild("Humanoid",5)
        if hum then
            hum.StateChanged:Connect(function(o,n)
                if n==Enum.HumanoidStateType.Jumping and stats[plr] then
                    stats[plr].jumps=stats[plr].jumps+1
                end
            end)
        end
    end
    plr.CharacterAdded:Connect(bindJump)
    if plr.Character then bindJump(plr.Character) end
end

for _,plr in ipairs(P:GetPlayers()) do init(plr) end
P.PlayerAdded:Connect(init)

RS.Heartbeat:Connect(function(dt)
    for _,plr in ipairs(P:GetPlayers()) do
        local s=stats[plr];if not s then init(plr);s=stats[plr] end
        local char=plr.Character
        if char then
            local hrp=char:FindFirstChild("HumanoidRootPart")
            if hrp then
                if s.lastPos then
                    local d=(hrp.Position-s.lastPos).Magnitude
                    if d>0.1 then s.walked=s.walked+d;s.lastMoveTime=tick() end
                    local sp=d/dt
                    if sp>s.maxSpeed then s.maxSpeed=sp end
                end
                s.lastPos=hrp.Position
                if tick()-s.lastMoveTime>3 then s.afkTime=s.afkTime+dt end
            end
        end
    end
end)

-- ===== ОПРЕДЕЛЕНИЕ СТАТУСА =====
local function getStatus(s)
    if not s then return "🙂 Новичок",Color3.fromRGB(200,200,200) end
    local j,w,a,mx=s.jumps or 0,s.walked or 0,s.afkTime or 0,s.maxSpeed or 0
    if a>60 then return "💤 АФК",Color3.fromRGB(150,150,200) end
    if j>80 then return "🦘 Джампер",Color3.fromRGB(100,255,150) end
    if w>800 then return "🏃 Ходок",Color3.fromRGB(255,200,100) end
    if mx>60 then return "⚡ Спринтер",Color3.fromRGB(255,150,80) end
    if j>30 and w>300 then return "🎯 Универсал",Color3.fromRGB(150,200,255) end
    if j>15 then return "🐰 Прыгун",Color3.fromRGB(180,255,180) end
    if w>200 then return "🚶 Пешеход",Color3.fromRGB(200,220,255) end
    return "🙂 Новичок",Color3.fromRGB(200,200,200)
end

