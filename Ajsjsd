--  УПРАВЛЕНИЕ
-- ============================================================

UserInputService.InputBegan:Connect(function(input)
    if not flying then return end
    
    local key = input.KeyCode
    if key == Enum.KeyCode.W then
        moveDirection = moveDirection + Vector3.new(0, 0, -1)
    elseif key == Enum.KeyCode.S then
        moveDirection = moveDirection + Vector3.new(0, 0, 1)
    elseif key == Enum.KeyCode.A then
        moveDirection = moveDirection + Vector3.new(-1, 0, 0)
    elseif key == Enum.KeyCode.D then
        moveDirection = moveDirection + Vector3.new(1, 0, 0)
    elseif key == Enum.KeyCode.Space then
        moveDirection = moveDirection + Vector3.new(0, 1, 0)
    elseif key == Enum.KeyCode.LeftShift then
        moveDirection = moveDirection + Vector3.new(0, -1, 0)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if not flying then return end
    
    local key = input.KeyCode
    if key == Enum.KeyCode.W then
        moveDirection = moveDirection - Vector3.new(0, 0, -1)
    elseif key == Enum.KeyCode.S then
        moveDirection = moveDirection - Vector3.new(0, 0, 1)
    elseif key == Enum.KeyCode.A then
        moveDirection = moveDirection - Vector3.new(-1, 0, 0)
    elseif key == Enum.KeyCode.D then
        moveDirection = moveDirection - Vector3.new(1, 0, 0)
    elseif key == Enum.KeyCode.Space then
        moveDirection = moveDirection - Vector3.new(0, 1, 0)
    elseif key == Enum.KeyCode.LeftShift then
        moveDirection = moveDirection - Vector3.new(0, -1, 0)
    end
end)

-- ============================================================
--  ФУНКЦИЯ ПОЛЁТА
-- ============================================================

local function StartFly()
    if not WaitForCharacter() then
        FlyButton.Text = "🛫 Ошибка!"
        return
    end
    
    local inputSpeed = tonumber(SpeedInput.Text)
    if inputSpeed and inputSpeed > 0 and inputSpeed <= 500 then
        speed = inputSpeed
    else
        speed = 30
        SpeedInput.Text = "30"
    end
    
    flying = true
    FlyButton.Text = "🛫 Fly: ВКЛ"
    FlyButton.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
    
    bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.Parent = HumanoidRootPart
    
    bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bg.CFrame = HumanoidRootPart.CFrame
    bg.Parent = HumanoidRootPart
    
    local humanoid = Character:FindFirstChild("Humanoid")
    if humanoid then
        humanoid.PlatformStand = true
    end
    
    moveDirection = Vector3.new(0, 0, 0)
end

local function StopFly()
    flying = false
    FlyButton.Text = "🛫 Fly: ВЫКЛ"
    FlyButton.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    
    if bv then bv:Destroy() bv = nil end
    if bg then bg:Destroy() bg = nil end
    
    local humanoid = Character and Character:FindFirstChild("Humanoid")
    if humanoid then
        humanoid.PlatformStand = false
    end
    
    moveDirection = Vector3.new(0, 0, 0)
end

-- ============================================================
--  ПОЛЁТ
-- ============================================================

RunService.Heartbeat:Connect(function()
    if flying and HumanoidRootPart and Camera then
        if bv then
            local moveVec = Vector3.new(0, 0, 0)
            local camForward = Camera.CFrame.LookVector
            local camRight = Camera.CFrame.RightVector
            local camUp = Camera.CFrame.UpVector
            
            moveVec = (camForward * -moveDirection.Z) + (camRight * moveDirection.X) + (camUp * moveDirection.Y)
            
            if moveVec.Magnitude > 0.1 then
                bv.Velocity = moveVec.Unit * speed
            else
                bv.Velocity = Vector3.new(0, 0, 0)
            end
        end
        if bg then
            bg.CFrame = Camera.CFrame
        end
    end
end)

