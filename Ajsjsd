--  АНИМАЦИЯ ЗАГРУЗКИ
-- ============================================================

local function LoadAnimation()
    -- Показываем первый экран
    BlackScreen1.BackgroundTransparency = 0
    Text1.TextTransparency = 0
    
    -- Ждём 3 секунды
    wait(3)
    
    -- Плавно убираем первый экран и показываем второй
    local tween1 = TweenService:Create(BlackScreen1, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = 1
    })
    local tween2 = TweenService:Create(Text1, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        TextTransparency = 1
    })
    
    tween1:Play()
    tween2:Play()
    
    -- Плавно появляется второй экран
    wait(0.3)
    local tween3 = TweenService:Create(BlackScreen2, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0
    })
    tween3:Play()
    
    -- Анимация полоски загрузки (10 секунд)
    local duration = 10
    local steps = 100
    local stepTime = duration / steps
    
    for i = 0, steps do
        local percent = i / steps
        LoadingBar.Size = UDim2.new(percent, 0, 1, 0)
        PercentText.Text = math.floor(percent * 100) .. "%"
        
        -- Меняем цвет полоски (градиент)
        local r = math.floor(percent * 255)
        local g = math.floor(150 + (1 - percent) * 105)
        local b = math.floor(255 - percent * 200)
        LoadingBar.BackgroundColor3 = Color3.fromRGB(r, g, b)
        
        wait(stepTime)
    end
    
    -- Загрузка завершена
    LoadingBar.Size = UDim2.new(1, 0, 1, 0)
    PercentText.Text = "100%"
    LoadingBar.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
    
    wait(0.3)
    
    -- Убираем загрузочный экран
    local tween4 = TweenService:Create(BlackScreen2, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = 1
    })
    tween4:Play()
    wait(0.5)
    
    -- Удаляем загрузочный экран
    LoadScreenGui:Destroy()
end

-- ============================================================
--  ЗАПУСКАЕМ ЗАГРУЗКУ В ОТДЕЛЬНОМ ПОТОКЕ
-- ============================================================

coroutine.wrap(LoadAnimation)()

