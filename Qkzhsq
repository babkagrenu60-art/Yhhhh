    end
end

-- ===== УДАР ЛОГИКА (с коллизией) =====
local function stopPunch()
    if loop then loop:Disconnect(); loop=nil end
    target=nil
    if LP.Character then
        for _,p in ipairs(LP.Character:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide=true end
        end
    end
    StopBtn.Text="⏹ СТОП"
end

local function doPunch(plr)
    stopPunch()
    target=plr
    StopBtn.Text="💥 БЬЮ: "..plr.Name

    local myChar=LP.Character
    if not myChar then return end
    local myHrp=myChar:FindFirstChild("HumanoidRootPart")
    local tChar=plr.Character
    if not tChar or not myHrp then return end
    local tHrp=tChar:FindFirstChild("HumanoidRootPart")
    if not tHrp then return end

    for _,p in ipairs(myChar:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide=true end
    end
    for _,p in ipairs(tChar:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide=true end
    end

    local dir=tHrp.Position-myHrp.Position
    if dir.Magnitude<0.1 then dir=Vector3.new(0,0,1) end
    local look=dir.Unit

    myHrp.CFrame=CFrame.new(tHrp.Position-look*3, tHrp.Position)
    tHrp.AssemblyLinearVelocity=look*400 + Vector3.new(0,180,0)

    loop=RS.Heartbeat:Connect(function()
        if not target or not target.Parent then stopPunch(); return end
        local mc=LP.Character
        local tc=target.Character
        if not mc or not tc then return end
        local mh=mc:FindFirstChild("HumanoidRootPart")
        local th=tc:FindFirstChild("HumanoidRootPart")
        if not mh or not th then return end

        for _,p in ipairs(mc:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide=true end
        end
        for _,p in ipairs(tc:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide=true end
        end

        local d=th.Position-mh.Position
        if d.Magnitude<0.1 then d=Vector3.new(0,0,1) end
        local l=d.Unit

        mh.CFrame=CFrame.new(th.Position-l*3, th.Position)
        mh.AssemblyLinearVelocity=l*300
        th.AssemblyLinearVelocity=l*400 + Vector3.new(0,180,0)
    end)
end

local function refreshPunch()
    for _,c in ipairs(PScroll:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end
    for _,plr in ipairs(P:GetPlayers()) do
        if plr~=LP then
            local btn=Instance.new("TextButton")
            btn.Size=UDim2.new(1,-8,0,30); btn.BackgroundColor3=Color3.fromRGB(45,30,40)
            btn.BorderSizePixel=0; btn.Text=plr.Name
            btn.TextColor3=Color3.fromRGB(255,180,180); btn.TextSize=12
            btn.Font=Enum.Font.Gotham; btn.AutoButtonColor=false; btn.Parent=PScroll
            corner(btn,6)
            btn.MouseButton1Click:Connect(function() doPunch(plr) end)
        end
    end
end

