-- ===== БЕССМЕРТИЕ ЛОГИКА =====
local function setStatus(t,c)
    SLbl.Text=t
    SLbl.TextColor3=c or Color3.fromRGB(150,150,160)
    SDot.BackgroundColor3=c or Color3.fromRGB(80,80,80)
end

local function inRound()
    local c=LP.Character
    if not c then return false end
    local h=c:FindFirstChildOfClass("Humanoid")
    local hrp=c:FindFirstChild("HumanoidRootPart")
    if not h or not hrp then return false end
    if h.Health<=0 then return false end
    local y=hrp.Position.Y
    if y<-50 or y>500 then return false end
    return true
end

local function onRespawn(char)
    if not active or not saved then return end
    setStatus("Респавн · возврат...",Color3.fromRGB(255,200,80))
    local hrp=char:WaitForChild("HumanoidRootPart",5)
    if not hrp then return end
    task.wait(CFG.Delay)
    if hrp and hrp.Parent and saved then
        local y=saved.Position.Y
        if y>-50 and y<500 then
            hrp.CFrame=saved
            setStatus("Активно · ждём смерть",Color3.fromRGB(80,255,120))
        else
            setStatus("Позиция невалидна",Color3.fromRGB(255,80,80))
        end
    end
end

local function activate()
    if not inRound() then
        setStatus("Не в раунде (лобби)",Color3.fromRGB(255,80,80)); return
    end
    local hrp=LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then setStatus("Нет HRP",Color3.fromRGB(255,80,80)); return end
    saved=hrp.CFrame
    active=true
    setStatus("Активация · сброс...",Color3.fromRGB(255,200,80))
    if conn then conn:Disconnect() end
    conn=LP.CharacterAdded:Connect(onRespawn)
    task.wait(CFG.ResetD)
    local c=LP.Character
    if c then
        local h=c:FindFirstChildOfClass("Humanoid")
        if h then h.Health=0 else c:BreakJoints() end
    end
    ImmTxt.Text="🔄  ПОВТОРИТЬ"
    ImmTxt.TextColor3=Color3.fromRGB(80,255,120)
    ImmBtn.BackgroundColor3=Color3.fromRGB(30,55,40)
    ImmSub.Text="Нажми ещё раз для повтора"
end

local function deactivate()
    active=false
    if conn then conn:Disconnect(); conn=nil end
    saved=nil
    setStatus("Готов",Color3.fromRGB(150,150,160))
    ImmTxt.Text="♻️  АКТИВИРОВАТЬ"
    ImmTxt.TextColor3=Color3.fromRGB(200,200,210)
    ImmBtn.BackgroundColor3=Color3.fromRGB(35,35,50)
    ImmSub.Text="Сохранит позицию и вернёт после смерти"
end

ImmBtn.MouseButton1Click:Connect(activate)
