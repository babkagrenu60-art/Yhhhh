local function getRole(plr)
    local c=plr.Character
    if not c then return "—",Color3.fromRGB(120,120,140) end
    for _,tag in ipairs{"Murderer","Sheriff","Innocent","Hero"} do
        if c:FindFirstChild(tag) then
            local col=tag=="Murderer" and Color3.fromRGB(255,80,80)
                or tag=="Sheriff" and Color3.fromRGB(80,150,255)
                or Color3.fromRGB(80,255,120)
            return tag,col
        end
    end
    local r=c:GetAttribute("Role") or plr:GetAttribute("Role")
    if r then
        local col=r=="Murderer" and Color3.fromRGB(255,80,80)
            or r=="Sheriff" and Color3.fromRGB(80,150,255)
            or Color3.fromRGB(80,255,120)
        return tostring(r),col
    end
    return "—",Color3.fromRGB(120,120,140)
end

local function refreshRoles()
    for _,c in ipairs(RScroll:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
