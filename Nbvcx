local function getChar()
    local c=LP.Character
    if not c then return nil,nil,nil end
    local h=c:FindFirstChildOfClass("Humanoid")
    local hrp=c:FindFirstChild("HumanoidRootPart")
    return c,h,hrp
end

local function findShelter()
    local _,_,hrp=getChar()
    if not hrp then return nil end
    local myPos=hrp.Position
    local best,bestScore=nil,math.huge

    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name~="Baseplate" then
            local part=obj
            local roofFound=false
            for _,child in ipairs(workspace:GetChildren()) do
                if child:IsA("BasePart") and child~=part then
                    if child.Position.Y>part.Position.Y+3 and (child.Position-part.Position).Magnitude<15 then
                        roofFound=true
                        break
                    end
                end
            end
            if roofFound then
                local d=(part.Position-myPos).Magnitude
                if d<50 and d>3 then
                    local score=d
                    if score<bestScore then
                        bestScore=score
                        best=part
                    end
                end
            end
        end
    end
    return best
end

local function findHighest()
    local _,_,hrp=getChar()
    if not hrp then return nil end
    local myPos=hrp.Position
    local highest=nil
    local maxY=-math.huge

    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name~="Baseplate" then
            local dist=(obj.Position-myPos).Magnitude
            if dist<100 and obj.Position.Y>maxY then
                maxY=obj.Position.Y
                highest=obj
            end
        end
    end
    return highest
end

local function findApple()
    local c=LP.Character
    if not c then return nil end
    for _,obj in ipairs(c:GetChildren()) do
        if obj:IsA("Tool") and obj.Name:lower():find("apple") then
            return obj
        end
    end
    return nil
end

local function useApple()
    local apple=findApple()
    if apple then
        pcall(function() apple:Activate() end)
        return true
    end
    return false
end

local function teleportTo(part)
    local _,_,hrp=getChar()
    if not hrp or not part then return end
    hrp.CFrame=CFrame.new(part.Position+Vector3.new(0,3,0))
end

local function checkTornado()
    local _,_,hrp=getChar()
    if not hrp then return false,999 end
    local myPos=hrp.Position
    local closest=nil
    local minDist=999

    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower():find("tornado") then
            local d=(obj.Position-myPos).Magnitude
            if d<minDist then
                minDist=d
                closest=obj
            end
        end
    end
    return closest~=nil,minDist,closest
end

