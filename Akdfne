IssuanceBtn.MouseButton1Click:Connect(function()
    if NickInput.Text == "" then 
        NickInput.PlaceholderText = "❌ ВВЕДИТЕ НИКНЕЙМ!"
        NickInput.PlaceholderColor3 = Color3.fromRGB(255, 0, 0)
        task.wait(2)
        NickInput.PlaceholderText = "Введите никнейм игрока..."
        NickInput.PlaceholderColor3 = Color3.fromRGB(120, 120, 120)
        return 
    end
    
    -- Показываем загрузку
    ModalOverlay.Visible = true
    TweenService:Create(ModalOverlay, 
        TweenInfo.new(0.3), 
        {BackgroundTransparency = 0.5}
    ):Play()
    
    -- Имитация процесса
    StatusLabel.Text = "Проверка аккаунта " .. NickInput.Text .. "..."
    task.wait(1.2)
    
    StatusLabel.Text = "Обработка транзакции " .. tostring(RobuxAmounts[currentSelectionIndex]) .. " R$..."
    task.wait(1.5)
    
    StatusLabel.Text = "✅ Успешно! Очистка кэша..."
    task.wait(0.8)
    
    -- Скрываем загрузку
    ModalOverlay.Visible = false
    ModalOverlay.BackgroundTransparency = 1
    
    -- Создаем уведомление об успехе
    local Notification = Instance.new("Frame")
    Notification.Parent = ScreenGui
    Notification.Size = UDim2.new(0, 300, 0, 60)
    Notification.Position = UDim2.new(0.5, -150, 0.02, 0)
    Notification.BackgroundColor3 = Color3.fromRGB(0, 180, 100)
    Notification.ZIndex = 20
    
    local NotifCorner = Instance.new("UICorner")
    NotifCorner.CornerRadius = UDim.new(0, 8)
    NotifCorner.Parent = Notification
    
    local NotifText = Instance.new("TextLabel")
    NotifText.Parent = Notification
    NotifText.Size = UDim2.new(1, 0, 1, 0)
    NotifText.BackgroundTransparency = 1
    NotifText.TextColor3 = Color3.fromRGB(255, 255, 255)
    NotifText.Font = Enum.Font.SourceSansBold
    NotifText.TextSize = 14
    NotifText.Text = "✅ " .. tostring(RobuxAmounts[currentSelectionIndex]) .. " R$ выдано " .. NickInput.Text .. "!"
    
    -- Анимация появления
    Notification.Position = UDim2.new(0.5, -150, -0.1, 0)
    TweenService:Create(Notification, 
        TweenInfo.new(0.5, Enum.EasingStyle.Back), 
        {Position = UDim2.new(0.5, -150, 0.02, 0)}
    ):Play()
    
    -- Удаляем через 3 секунды
    task.wait(3)
    TweenService:Create(Notification, 
        TweenInfo.new(0.3), 
        {Position = UDim2.new(0.5, -150, -0.1, 0)}
    ):Play()
    task.wait(0.3)
    Notification:Destroy()
end)

