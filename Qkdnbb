-- ===== ПРОВЕРКА СТЕНЫ =====
local function getWall()
    local char=LP.Character
    if not char then return nil end
    local hrp=char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={char}

    -- Луч вперёд от игрока (по направлению взгляда камеры)
    local cam=workspace.CurrentCamera
    local look=cam.CFrame.LookVector
    -- Ограничиваем по горизонтали (убираем вертикаль)
    look=Vector3.new(look.X,0,look.Z)
    if look.Magnitude<0.01 then return nil end
    look=look.Unit

    local origin=hrp.Position
    local dir=look*5 -- проверяем на 5 стадов вперёд

    local result=workspace:Raycast(origin,dir,params)
    if result and result.Instance and result.Instance:IsA("BasePart") then
        -- Убеждаемся, что это "стена" — нормаль почти горизонтальна
        local normal=result.Normal
        local horizNormal=Vector3.new(normal.X,0,normal.Z)
        if horizNormal.Magnitude>0.5 then
            return result, look
        end
    end
    return nil
end

-- ===== ОТСКОК =====
local function doWallClutch()
    local char=LP.Character
    if not char then return end
    local hrp=char:FindFirstChild("HumanoidRootPart")
    local hum=char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    local result,look=getWall()
    if not result then
        StatusLbl.Text="Нет стены впереди"
        StatusLbl.TextColor3=Color3.fromRGB(255,120,120)
        return
    end

    -- Отскок назад: направление = -look (обратно)
    local backward=-look

    -- Отключаем коллизию на миг, чтобы отлететь сквозь возможные препятствия
    local parts={}
    for _,p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            parts[p]=p.CanCollide
            p.CanCollide=false
        end
    end

    -- Телепорт назад на Distance блоков с физическим импульсом
    local startPos=hrp.Position
    local targetPos=startPos + backward*Distance

    -- Проверяем, что не улетим в стену/пол — raycast вниз
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={char}
    local downRay=workspace:Raycast(targetPos,Vector3.new(0,-50,0),params)
    if downRay then
        targetPos=Vector3.new(targetPos.X,downRay.Position.Y+3.5,targetPos.Z)
    end

    -- Плавный быстрый телепорт (несколько кадров)
    local steps=6
    for i=1,steps do
        if not hrp.Parent then break end
        local alpha=i/steps
        hrp.CFrame=CFrame.new(startPos:Lerp(targetPos,alpha))
        RS.RenderStepped:Wait()
    end

    -- Возвращаем коллизию
    task.wait(0.05)
    for p,val in pairs(parts) do
        if p and p.Parent then p.CanCollide=val end
    end

    StatusLbl.Text="Отскок · "..Distance.." блоков"
    StatusLbl.TextColor3=CFG.Accent
end

-- ===== ОБРАБОТКА ПРЫЖКА =====
local function onJumpRequest()
    if not isActive then return end
    local now=tick()
    if now-lastJump<0.3 then return end -- антиспам
    lastJump=now
    doWallClutch()
end

-- UIS.JumpRequest — срабатывает на пробел/кнопку прыжка
local function onInputBegan(input,gpe)
    if gpe then return end
    if input.KeyCode==Enum.KeyCode.Space then
        onJumpRequest()
    end
end

UIS.InputBegan:Connect(onInputBegan)
UIS.JumpRequest:Connect(onJumpRequest)

