    ToggleButton.Visible = true
end
ToggleButton.MouseButton1Click:Connect(OpenMenu)

-- Глобальные переменные
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local UserInputService = game:GetService("UserInputService")

-- ========== ТЕЛЕПОРТ К СОКРОВИЩАМ ==========
local function TeleportToTreasure()
    local player = LocalPlayer
    local character = player.Character
    if not character then
        Library:Notify({Title = "Ошибка", Content = "Персонаж не найден!", Duration = 2})
        return
    end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        Library:Notify({Title = "Ошибка", Content = "HumanoidRootPart не найден!", Duration = 2})
        return
    end
    
    -- Ищем сокровище
    local treasure = nil
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Part") and v.Name == "Treasure" then
            treasure = v
            break
        end
    end
    
    if not treasure then
        Library:Notify({Title = "Ошибка", Content = "Сокровище не найдено!", Duration = 2})
        return
    end
    
    -- Сохраняем позицию и телепортируемся
    local oldPos = hrp.CFrame
    hrp.CFrame = treasure.CFrame * CFrame.new(0, 5, 0)
    task.wait(0.3)
    
    -- Проверяем, подобрали ли сокровище
    if workspace:FindFirstChild("Treasure") then
        hrp.CFrame = oldPos
        Library:Notify({Title = "Неудача", Content = "Сокровище еще не появилось!", Duration = 2})
    else
        Library:Notify({Title = "Успех", Content = "Сокровище подобрано!", Duration = 2})
    end
end

