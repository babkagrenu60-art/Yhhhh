-- // ================= АНИМАЦИИ =================
local function setStatus(text, color)
    StatusLabel.Text = text
    StatusLabel.TextColor3 = color or Color3.fromRGB(150, 150, 160)
    StatusDot.BackgroundColor3 = color or Color3.fromRGB(80, 80, 80)
end

local function openGui()
    if guiOpen then return end
    guiOpen = true
    MainFrame.Visible = true
    MainFrame.Size = UDim2.new(0, 0, 0, 0)
    TweenService:Create(MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = CONFIG.GuiSize
    }):Play()
end

local function closeGui()
    if not guiOpen then return end
    guiOpen = false
    local tween = TweenService:Create(MainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0)
    })
    tween:Play()
    tween.Completed:Connect(function()
        MainFrame.Visible = false
    end)
end

-- Клик по иконке — открыть/закрыть
ToggleIcon.MouseButton1Click:Connect(function()
    if guiOpen then
