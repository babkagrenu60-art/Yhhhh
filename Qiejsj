-- // ================= ПЕРЕТАСКИВАНИЕ ОКНА =================
local dragging, dragInput, dragStart, startPos = false, nil, nil, nil

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

TitleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

-- // ================= ПЕРЕТАСКИВАНИЕ ИКОНКИ =================
local iconDragging, iconDragStart, iconStartPos = false, nil, nil

ToggleIcon.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        iconDragging = true
        iconDragStart = input.Position
        iconStartPos = ToggleIcon.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                iconDragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if iconDragging and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - iconDragStart
        ToggleIcon.Position = UDim2.new(
            iconStartPos.X.Scale, iconStartPos.X.Offset + delta.X,
            iconStartPos.Y.Scale, iconStartPos.Y.Offset + delta.Y
        )
    end
end)

-- // ================= ОСНОВНАЯ ЛОГИКА =================

-- Запомнить текущую позицию
local function saveCurrentPosition()
    local char = LocalPlayer.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    savedCFrame = hrp.CFrame
    return true
end

-- После респавна — телепорт обратно
local function onCharacterAdded(character)
    if not isActive or not savedCFrame then return end
    setStatus("Респавн · возврат...", Color3.fromRGB(255, 200, 80))

    local hrp = character:WaitForChild("HumanoidRootPart", 5)
    if not hrp then return end

    task.wait(CONFIG.TeleportDelay)

    if hrp and hrp.Parent and savedCFrame then
        hrp.CFrame = savedCFrame
        setStatus("Активно · ждём смерть", Color3.fromRGB(80, 255, 120))
    end
end

-- Полный цикл: сохранить -> сбросить -> вернуть
local function activateImmortal()
    -- 1) Сохраняем позицию
    if not saveCurrentPosition() then
        setStatus("Ошибка: нет персонажа", Color3.fromRGB(255, 80, 80))
        return
    end

    isActive = true
    setStatus("Активация · сброс...", Color3.fromRGB(255, 200, 80))

    -- 2) Подключаем слушатель респавна
    if characterConn then characterConn:Disconnect() end
    characterConn = LocalPlayer.CharacterAdded:Connect(onCharacterAdded)

    -- 3) Сбрасываем персонажа
    task.wait(CONFIG.ResetDelay)
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.Health = 0
        else
            char:BreakJoints()
        end
    end

    -- UI
    BtnText.Text = "🔄  ПОВТОРИТЬ"
    BtnText.TextColor3 = Color3.fromRGB(80, 255, 120)
    BtnStroke.Color = Color3.fromRGB(80, 255, 120)
    ActionBtn.BackgroundColor3 = Color3.fromRGB(30, 55, 40)
    BtnSubText.Text = "Нажми ещё раз для повтора"
end

-- Полное выключение
local function deactivateImmortal()
    isActive = false
    if characterConn then
        characterConn:Disconnect()
        characterConn = nil
    end
    savedCFrame = nil

    setStatus("Готов", Color3.fromRGB(150, 150, 160))
    BtnText.Text = "♻️  АКТИВИРОВАТЬ"
    BtnText.TextColor3 = Color3.fromRGB(200, 200, 210)
    BtnStroke.Color = Color3.fromRGB(80, 80, 100)
    ActionBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
    BtnSubText.Text = "Сохранит позицию и вернёт после смерти"
end

-- Обработчик кнопки
ActionBtn.MouseButton1Click:Connect(function()
    -- Анимация нажатия
    TweenService:Create(ActionBtn, TweenInfo.new(0.1), {
        BackgroundColor3 = Color3.fromRGB(60, 60, 80)
    }):Play()
    task.wait(0.1)

    if isActive then
        -- Уже активно — перезапускаем цикл (заново сохранить и сбросить)
        activateImmortal()
    else
        activateImmortal()
    end
end)

-- ПКМ по кнопке — выключить
ActionBtn.MouseButton2Click:Connect(deactivateImmortal)

