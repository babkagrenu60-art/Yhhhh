-- ===== РЫВОК =====
local function startDash()
    if dashing then return end
    local char=LP.Character
    if not char then return end
    local hrp=char:FindFirstChild("HumanoidRootPart")
    local hum=char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    dashing=true
    jumpBlocked=true
    savedWalkSpeed=hum.WalkSpeed
    savedJumpPower=hum.JumpPower

    hum.JumpPower=0
    hum.UseJumpPower=true
    hum:SetStateEnabled(Enum.HumanoidStateType.Jumping,false)
    hum:SetStateEnabled(Enum.HumanoidStateType.Freefall,false)

    local cam=workspace.CurrentCamera
    local look=cam.CFrame.LookVector
    look=Vector3.new(look.X,0,look.Z)
    if look.Magnitude<0.01 then look=Vector3.new(0,0,-1) end
    look=look.Unit

    hum.WalkSpeed=dashSpeed

    DashBtn.Text="💨  АКТИВЕН..."
    DashBtn.BackgroundColor3=Color3.fromRGB(80,50,30)
    DashBtn.TextColor3=Color3.fromRGB(255,200,100)
    StopBtn.BackgroundColor3=Color3.fromRGB(120,40,40)
    StopBtn.Text="⏹  ЗАВЕРШИТЬ (АКТИВНО)"
    StatusLbl.Text="Рывок · прыжок OFF"
    StatusLbl.TextColor3=Color3.fromRGB(255,200,100)

    local startTime=tick()
    if dashLoop then dashLoop:Disconnect() end
    dashLoop=RS.Heartbeat:Connect(function()
        if not dashing then return end
        local c=LP.Character
        if not c then return end
        local h=c:FindFirstChild("HumanoidRootPart")
        local hu=c:FindFirstChildOfClass("Humanoid")
        if not h or not hu then return end

        hu.WalkSpeed=dashSpeed
        hu.JumpPower=0
        hu:SetStateEnabled(Enum.HumanoidStateType.Jumping,false)
        hu:SetStateEnabled(Enum.HumanoidStateType.Freefall,false)

        if hu:GetState()==Enum.HumanoidStateType.Jumping then
            hu:ChangeState(Enum.HumanoidStateType.Running)
        end

        h.AssemblyLinearVelocity=Vector3.new(look.X*dashSpeed,h.AssemblyLinearVelocity.Y,look.Z*dashSpeed)

        if tick()-startTime>=dashDuration then
            stopDash()
        end
    end)
end

function stopDash()
    if not dashing and not jumpBlocked then return end
    dashing=false
    jumpBlocked=false
    if dashLoop then dashLoop:Disconnect();dashLoop=nil end

    local char=LP.Character
    if char then
        local hum=char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed=savedWalkSpeed
            hum.JumpPower=savedJumpPower
            hum:SetStateEnabled(Enum.HumanoidStateType.Jumping,true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Freefall,true)
        end
    end

    DashBtn.Text="💨  РЫВОК ВПЕРЁД"
    DashBtn.BackgroundColor3=Color3.fromRGB(35,55,80)
    DashBtn.TextColor3=Color3.fromRGB(150,220,255)
    StopBtn.BackgroundColor3=Color3.fromRGB(60,25,25)
    StopBtn.Text="⏹  ЗАВЕРШИТЬ"
    StatusLbl.Text="Готов к рывку"
    StatusLbl.TextColor3=Color3.fromRGB(150,150,160)
end

